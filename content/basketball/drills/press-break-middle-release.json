  "content": {
    "objective": "Get open quickly in the middle of the floor to relieve pressure on the inbound pass.",
    "setup": "An inbounder faces full-court pressure with two or three teammates spread to receive the pass.",
    "organization": "",
    "instructions": [
      "One guard flashes hard to the middle of the floor, timing the cut with the inbounder's release.",
      "The inbounder delivers a quick, accurate pass to the middle before pressure arrives.",
      "The receiver pivots away from defenders immediately after the catch.",
      "Reset and vary which guard flashes to the middle each rep."
    ],
    "coachingPoints": [
      "Flash with urgency — a slow cut gets covered easily.",
      "Inbounder should release the pass quickly, not wait and get trapped.",
      "Receiver should catch facing up the floor, ready to advance the ball."
    ],
    "commonMistakes": [
      "Flashing too early and getting there before the defense even sets up.",
      "Inbounder holding the ball too long before finding the release.",
      "Panicking under pressure instead of looking for the simple, safe pass."
    ],
    "safety": "Keep the full-court pressure controlled and game-realistic, not reckless.",
