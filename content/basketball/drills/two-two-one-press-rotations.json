  "content": {
    "objective": "Slow the ball, force it to the sideline and trap at half court with organised rotations behind.",
    "setup": "Five defenders in a 2-2-1 after a made basket; offense inbounds.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "Front two allow the inbound and force the ball to the sideline.",
      "As the ball crosses the free-throw line extended, the middle defender on that side traps with a front defender.",
      "The other middle defender covers the middle pass.",
      "The safety (last defender) protects the rim and the long pass.",
      "If the ball escapes, everyone sprints back to half-court defense."
    ],
    "coachingPoints": [
      "Force sideline, never middle.",
      "Trap with the sideline as a third defender.",
      "Sprint back when broken."
    ],
    "commonMistakes": [
      "Letting the ball into the middle.",
      "Trapping too early, in the backcourt corner.",
      "Safety jumping a pass and leaving the rim."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Live offense with a press-break set.",
      "Trap after the first pass."
    ],
    "regressions": [
      "Walk-through.",
      "Offense not allowed to dribble."
    ],
    "variations": [
      "Drop to man after half court.",
      "3/4 court version."
    ],
    "successCriteria": [
