  "content": {
    "objective": "Finish in transition with a defender chasing, protecting the ball with the body and finishing on the far side.",
    "setup": "Finisher at half court; chaser two metres behind.",
    "organization": "Switch roles each rep.",
    "instructions": [
      "On the whistle, the finisher speed-dribbles to the rim.",
      "The chaser sprints to contest from behind.",
      "The finisher keeps the body between chaser and ball.",
      "Finish on the side away from the chaser, or jump-stop and fake if they arrive.",
      "Switch roles."
    ],
    "coachingPoints": [
      "Do not slow down to look back.",
      "Finish away from the chaser.",
      "Use the jump stop if caught."
    ],
    "commonMistakes": [
      "Floating the lay-up out where the chaser can block it.",
      "Slowing down near the rim.",
      "Finishing with the hand nearest the chaser."
    ],
    "safety": "Chasers contest the ball only; no pushing from behind.",
    "progressions": ["Smaller head start.", "Second chaser from the side."],
    "regressions": ["Bigger head start.", "Chaser jogs."],
    "variations": ["Start from a steal at half court.", "Euro step away from the chaser."],
    "successCriteria": ["Finishes at a good rate.", "Never blocked from behind."],
