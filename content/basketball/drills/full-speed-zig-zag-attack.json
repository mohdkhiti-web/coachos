  "content": {
    "objective": "Keep full control of the ball while changing direction at game speed.",
    "setup": "Players start under the basket with a ball and attack in a wide zig-zag toward half court.",
    "organization": "",
    "instructions": [
      "Sprint-dribble at a 45-degree angle toward one sideline.",
      "Plant the outside foot and crossover hard to change direction.",
      "Repeat the angle change three or four times on the way to half court.",
      "Jog back with the ball under control and go again."
    ],
    "coachingPoints": [
      "Lower the hips before the change of direction, not after.",
      "Keep the ball on the outside hand, away from an imaginary defender.",
      "Accelerate out of every change of direction."
    ],
    "commonMistakes": [
      "Standing up out of the stance when changing direction.",
      "Slowing down too much between direction changes.",
      "Letting the off-hand drop instead of staying ready to protect the ball."
    ],
    "safety": "Make sure there is a clear, open lane before sprinting at full speed.",
