  "content": {
    "objective": "Protect the ball from a reaching defender with a low rip-through and shoot in balance after it.",
    "setup": "Passer at the top; shooter at the wing; defender closing out.",
    "organization": "Rotate shooter, defender, passer.",
    "instructions": [
      "Catch at the wing in triple threat.",
      "The defender reaches for the ball.",
      "Rip the ball low across the knees from the high side to the low side.",
      "Bring it back up to the shooting pocket and shoot if the defender retreats.",
      "If the defender stays low, drive the open side instead."
    ],
    "coachingPoints": [
      "Rip below the knees, fast.",
      "Keep the pivot foot planted.",
      "Return to the pocket before shooting."
    ],
    "commonMistakes": [
      "Ripping at waist height into the defender's hands.",
      "Swinging elbows into the defender (foul).",
      "Travelling on the rip."
    ],
    "safety": "Elbows stay close to the body; no swinging at the defender's head.",
    "progressions": ["Rip-through and one-dribble pull-up.", "Live 1v1 after the rip."],
