  "content": {
    "objective": "Keep the ball low and change direction sharply at each closely spaced cone.",
    "setup": "Six cones are placed in a zig-zag roughly a metre apart down the length of the court.",
    "organization": "",
    "instructions": [
      "Dribble with the outside hand approaching each cone.",
      "Crossover low and tight exactly as you reach each cone.",
      "Accelerate for two dribbles between cones, then decelerate into the next crossover.",
      "Jog back and repeat with the other hand leading."
    ],
    "coachingPoints": [
      "Change speed, not just direction, at every cone.",
      "Keep the ball below the knee through each crossover.",
      "Protect the ball with the off-hand and a forearm bar."
    ],
    "commonMistakes": [
      "Dribbling in a straight line and ignoring the zig-zag.",
      "Standing up tall while weaving through.",
      "Letting the off-hand drop instead of staying ready to protect the ball."
    ],
    "safety": "Make sure the cone line is clear of other groups before starting.",
    "progressions": [],
    "regressions": [],
    "variations": ["Finish the last cone with a hesitation move and a sprint to the rim."]
  },
