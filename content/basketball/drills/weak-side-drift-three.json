  "content": {
    "objective": "Move to the open spot behind the help on a baseline drive and shoot off the skip or kick pass.",
    "setup": "Driver at the right wing; shooter at the left wing; optional help defender.",
    "organization": "Rotate driver and shooter.",
    "instructions": [
      "The driver attacks baseline from the right wing.",
      "As the help defender steps in, the left wing drifts down to the left corner.",
      "The driver jump-stops or passes on the move to the left corner.",
      "The shooter catches with the feet behind the line and shoots.",
      "Repeat from the other side."
    ],
    "coachingPoints": [
      "Drift on the drive, not before.",
      "Stay in the driver's line of sight.",
      "Arrive with the feet ready."
    ],
    "commonMistakes": [
