  "content": {
    "objective": "Stop on balance off a live dribble and shoot with the same mechanics as a catch-and-shoot.",
    "setup": "Shooter starts at the three-point line with a ball, facing the basket.",
    "organization": "",
    "instructions": [
      "Dribble hard toward the free-throw line for two or three dribbles.",
      "Plant and rise into a balanced jump shot without drifting forward or sideways.",
      "Collect the rebound and go to the next spot around the arc.",
      "Repeat at each of three spots, both hands leading the dribble."
    ],
    "coachingPoints": [
      "Gather the ball before the feet plant, not after.",
      "Keep the shoulders square to the basket at the top of the jump.",
      "Land in the same spot you jumped from — no drift."
    ],
    "commonMistakes": [
      "Drifting forward on the landing, a common sign of poor balance.",
      "Taking too many dribbles and losing rhythm before shooting.",
      "Dropping the follow-through early instead of holding it."
    ],
    "safety": "Make sure the driving lane is clear before attacking at speed.",
