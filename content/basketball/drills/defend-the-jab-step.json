  "content": {
    "objective": "React to a jab step with a small retreat (not a lunge), staying balanced for the shot or drive.",
    "setup": "Offense with the ball at the wing in triple threat; defender in front.",
    "organization": "Live 1v1; switch after each possession.",
    "instructions": [
      "The offensive player jabs at the defender.",
      "The defender takes a short retreat step with the back foot, keeping the stance.",
      "If the offense rises to shoot, contest with a high hand.",
      "If they drive, slide and cut off.",
      "Play live for five seconds."
    ],
    "coachingPoints": [
      "Retreat step, not a jump.",
      "Weight on the balls of the feet.",
      "Hand up after every jab."
    ],
    "commonMistakes": [
      "Lunging backward and giving an open shot.",
      "Biting toward the jab foot.",
      "Crossing the feet."
    ],
    "safety": "Defenders play legally: chest up, no reaching across the body, no pushing; stop play on any dangerous contact.",
    "progressions": ["Two jabs in a row.", "Offense may use a jab-crossover."],
    "regressions": ["Offense jabs without attacking.", "Walk-through."],
