  "content": {
    "objective": "Use an empty-corner side ball screen to create a roll to the rim or a kick to the weak side.",
    "setup": "Ball handler at the right wing; screener; two weak-side shooters (left wing, left corner); four defenders.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "The right corner is empty.",
      "The screener sets a side ball screen.",
      "The ball handler attacks the middle; the screener rolls to the rim.",
      "The low help comes from the weak side.",
      "Read: lob/bounce to the roller or kick to the open shooter."
    ],
    "coachingPoints": [
      "Keep the corner empty.",
