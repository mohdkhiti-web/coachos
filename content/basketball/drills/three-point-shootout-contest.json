  "content": {
    "objective": "Shoot with both volume and accuracy under a timed, head-to-head scoring format.",
    "setup": "Five balls are placed at each of five spots around the three-point arc; a timer is set for 45 to 60 seconds.",
    "organization": "",
    "instructions": [
      "The shooter works through all five balls at a spot before moving to the next spot.",
      "Continue around all five spots, re-racking as needed, until time expires.",
      "Count total makes as the final score for that turn.",
      "Compare scores between players across multiple rounds."
    ],
    "coachingPoints": [
      "Keep the shooting motion consistent even as the pace increases.",
      "Move efficiently between spots to maximise shots taken.",
      "Stay composed if an early rack goes poorly — there's time to recover."
    ],
    "commonMistakes": [
      "Rushing so much that shooting mechanics completely break down.",
      "Wasting time chasing long rebounds instead of grabbing the next rack ball.",
      "Losing composure after a bad result instead of resetting for the next one."
    ],
    "safety": "Keep the rebounding area behind the shooter clear of other players.",
