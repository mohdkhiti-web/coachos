  "content": {
    "objective": "Find a player, make contact and box out, then pursue the ball with two hands and finish the rebound strongly.",
    "setup": "Three offensive rebounders start around the lane and three defenders are matched to them. A coach or a shooter takes a shot from the wing or top of the key.",
    "instructions": [
      "The shooter shoots and immediately joins the defenders.",
      "Defenders must first find a player, make contact and box out before pursuing the ball.",
      "Offensive rebounders try to fight for position and score after a rebound.",
      "Defensive rebounds score one point; offensive rebounds followed by a make score two.",
      "Play to seven points, then swap the offence and defence."
    ],
    "coachingPoints": [
      "See the shooter, find your player, make contact, then go to the ball.",
      "Use a wide base and keep arms bent when boxing out.",
      "Hold contact until the ball is in the air, then release and get it.",
      "Land with the ball tucked under the chin."
    ],
    "commonMistakes": [
      "Watching the ball instead of finding the player first.",
      "Boxing out with straight arms and getting a foul.",
      "Jumping too early and getting boxed out."
    ],
    "safety": "Only body contact; no pushing, holding or hooking. Keep elbows below the shoulders.",
    "progressions": ["Add a fourth rebounder and require a defensive outlet after every rebound."],
    "regressions": ["Coach tosses the ball instead of a live shot."],
    "variations": ["Make the game a first-to-five with 2-on-2 in the lane."]
  },
