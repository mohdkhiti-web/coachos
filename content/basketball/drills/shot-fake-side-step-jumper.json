  "content": {
    "objective": "Use a convincing shot fake and a balanced side-step (one dribble or none) to create a clean shot against a hard closeout.",
    "setup": "Passer at the top; shooter at the wing; a defender closes out from the lane.",
    "organization": "Rotate passer, shooter, defender.",
    "instructions": [
      "The shooter catches the pass ready to shoot.",
      "The defender closes out hard.",
      "Shot fake: bring the ball up to the forehead, eyes on the rim, legs still bent.",
      "As the defender rises, side-step (one dribble or a legal hop) to the side.",
      "Square up and shoot."
    ],
    "coachingPoints": [
      "Fake with the ball and eyes, not by standing up.",
      "Side-step wide, past the defender's body.",
      "Land square before shooting."
    ],
    "commonMistakes": [
      "Straightening the legs on the fake.",
      "Side-step that drifts away from the rim.",
      "Travelling on the hop."
    ],
    "safety": "Defenders contest without jumping into the shooter.",
    "progressions": ["Live defender who may stay down.", "Side-step into a three."],
    "regressions": ["Defender jumps on cue.", "No dribble: fake and shoot."],
    "variations": ["Fake and drive past instead.", "Side-step toward the baseline."],
    "successCriteria": [
      "Defender bites on the fake most of the time.",
      "Shot taken in balance after the side-step."
    ],
    "gameApplication": "The side-step jumper punishes defenders who close out too hard on shooters.",
