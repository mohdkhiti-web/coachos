  "content": {
    "objective": "Build range gradually, only moving back once makes are consistent at the closer distance.",
    "setup": "Shooter starts directly under the basket with a ball.",
    "organization": "",
    "instructions": [
      "Make five shots in a row directly under the basket using correct form.",
      "Move to the block and repeat, then the elbow, then the free-throw line.",
      "If a spot isn't making five in a row within ten shots, stay there longer before moving back.",
      "Rebound your own shot each time to keep the pace quick."
    ],
    "coachingPoints": [
      "Prioritise form over makes at every step — a lucky make with bad form doesn't count.",
      "Use full legs on every shot, even close to the rim.",
      "Keep the same release point regardless of distance."
    ],
    "commonMistakes": [
      "Rushing back to the free-throw line before form is solid closer in.",
      "Losing the follow-through once shots start missing.",
      "Dropping the follow-through early instead of holding it."
    ],
    "safety": "Watch for other players' rebounds crossing your shooting lane.",
