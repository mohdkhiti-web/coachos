  "content": {
    "objective": "Beat a press with a quick inbound and a return pass to the inbounder.",
    "setup": "Inbounder on the baseline; receiver at the elbow; two pressing defenders.",
    "organization": "Rotate every four reps.",
    "instructions": [
      "The receiver gets open with a V-cut and catches the inbound.",
      "The inbounder steps in immediately and moves to the opposite side.",
      "If the receiver is trapped, pass back to the inbounder.",
      "The inbounder attacks the open side.",
      "Advance past half court."
    ],
    "coachingPoints": [
      "Step in right after the pass.",
      "Stay behind the ball as the safety.",
      "Receiver pivots to see the floor."
    ],
    "commonMistakes": [
      "Inbounder standing out of bounds.",
      "Receiver dribbling into the trap.",
      "Lob passes over defenders."
    ],
    "safety": "Trappers play the ball, not the body; no reaching across the inbounder's arms over the line.",
    "progressions": ["Third defender.", "Five-second count."],
    "regressions": ["Defenders passive.", "No trap."],
    "variations": ["After a made basket (running the baseline).", "Sideline inbound."],
    "successCriteria": ["Ball across half court within eight seconds.", "No turnovers."],
    "gameApplication": "The inbounder is often the most open player against a press.",
