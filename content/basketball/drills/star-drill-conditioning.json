  "content": {
    "objective": "Build agility and conditioning together by varying movement type across a star-shaped pattern.",
    "setup": "Five cones are arranged in a star pattern with a clear centre point.",
    "organization": "",
    "instructions": [
      "Sprint from the centre to the first cone and sprint back.",
      "Shuffle laterally from the centre to the second cone and shuffle back.",
      "Backpedal from the centre to the third cone and sprint forward back.",
      "Continue the pattern through all five points, varying the movement type at each."
    ],
    "coachingPoints": [
      "Stay low through shuffles and backpedals, not just the sprints.",
      "Touch each cone clearly before returning to the centre.",
      "Keep the same intensity on the final point as the first."
    ],
    "commonMistakes": [
      "Rounding the cone instead of touching it directly.",
      "Slowing the movement quality as fatigue builds late in the set.",
      "Pacing too conservatively instead of working at real effort."
    ],
    "safety": "Make sure the cones are stable and the floor is clear around the star pattern.",
