  "content": {
    "objective": "Get to the weak-side rebounding spot on a shot from the strong side before the defender can box out.",
    "setup": "Attacker at the left wing; defender in help position; coach shooting from the right side.",
    "organization": "Four reps each; rotate.",
    "instructions": [
      "The coach shoots from the right wing or corner.",
      "On the release, the attacker attacks the defender's top foot with a fake.",
      "Step inside with the opposite foot and crash to the weak-side block.",
      "Get a hand on the ball: tip, catch or put back.",
      "The defender tries to box out."
    ],
    "coachingPoints": [
      "Go on the release.",
      "Fake high, go low and inside.",
      "Weak side gets most misses."
    ],
    "commonMistakes": [
      "Crashing straight into the defender.",
      "Waiting to see if it misses.",
      "Going over the back (foul)."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
    "progressions": [
      "Two crashers.",
      "Defender starts closer."
    ],
    "regressions": [
      "Defender passive.",
      "Coach misses on purpose."
    ],
    "variations": [
