    "objective": "Stay with a moving partner using quick feet, the basic idea of guarding someone.",
    "setup": "Pairs inside the half court.",
    "organization": "30-second rounds; switch roles.",
    "instructions": [
      "The leader moves around the half court (walk, jog, change direction).",
      "The shadow stays within an arm's length.",
      "On the whistle, both freeze; the shadow scores a point if still close.",
      "Switch roles.",
      "Add slides: the shadow must face the leader."
    ],
    "coachingPoints": [
      "Face your partner.",
      "Small, quick steps.",
      "Watch the belly button, not the feet."
    ],
    "commonMistakes": [
      "Chasing from behind.",
      "Big steps that overrun.",
      "Crossing feet when sliding."
    ],
    "safety": "Jogging pace in a crowded space; leaders cannot run backward into others.",
    "progressions": ["Leader dribbles a ball.", "Shadow must stay in a stance."],
    "regressions": ["Walking only.", "Larger distance allowed."],
    "variations": ["Leader can 'escape' by touching a line.", "Groups of three: two shadows."],
    "successCriteria": ["Close at most freezes.", "Faces the partner throughout."],
