  "content": {
    "objective": "Keep a side ball screen from turning into a middle drive by 'icing' it toward the baseline.",
    "setup": "Ball handler at the right wing; screener coming from the elbow; two defenders.",
    "organization": "Rotate pairs every four reps.",
    "instructions": [
      "The screener's defender calls 'ICE!' as the screen comes.",
      "The on-ball defender jumps to the top side of the ball handler, denying the screen.",
      "The ball handler is forced toward the baseline.",
      "The big's defender drops to the block to wall the drive, staying between ball and rim.",
      "Recover to the roller as the guard defender catches up."
    ],
    "coachingPoints": [
      "Call it early.",
      "On-ball defender's body is above the ball, not behind.",
      "Big walls the baseline, does not chase."
    ],
    "commonMistakes": [
      "On-ball defender going over the screen anyway.",
      "Big stepping out too high.",
      "No recovery to the roller."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Live 2v2 with a weak-side helper.",
      "Ball handler rejects the screen."
    ],
    "regressions": [
      "Walk-through.",
      "Ball handler at half speed."
    ],
    "variations": [
