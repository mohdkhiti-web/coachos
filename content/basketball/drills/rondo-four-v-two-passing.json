  "content": {
    "objective": "Keep possession against two defenders through quick decisions, fakes and passes between the defenders.",
    "setup": "A square about six metres a side marked with cones; one passer on each side, two defenders inside.",
    "organization": "The defender who forces a turnover swaps with the passer who lost it.",
    "instructions": [
      "Passers stay on their side of the square but may slide along it.",
      "Pass to any other passer; no lob passes over head height.",
      "Count consecutive passes: ten in a row earns a point.",
      "A deflection, steal or pass out of the square swaps the defender with the passer at fault.",
      "Play two-minute rounds."
    ],
    "coachingPoints": [
      "Pass between the two defenders when the gap opens.",
      "Fake before every pass.",
      "Receivers slide to make the passing angle."
    ],
    "commonMistakes": [
      "Always passing to the nearest player.",
      "Holding the ball until both defenders arrive.",
      "Floaty passes that defenders can step into."
    ],
    "safety": "Defenders do not dive for the ball; no slapping arms.",
    "progressions": ["Shrink the square.", "Passers must pass within two seconds."],
    "regressions": ["5v2 with an extra passer.", "Bigger square."],
    "variations": ["Bounce passes only.", "Defenders score by forcing a held ball (five seconds)."],
    "successCriteria": [
      "Ten consecutive passes at least once per round.",
      "Splitting passes between the defenders."
    ],
    "gameApplication": "Passing against two defenders mirrors passing out of traps and against active zones.",
    "repetitions": "3 rounds of 2 minutes",
