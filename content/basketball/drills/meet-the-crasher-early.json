  "content": {
    "objective": "Stop a crashing perimeter player at the arc so they never reach the rebounding area.",
    "setup": "Attacker at the wing, defender guarding them; coach shooting from the opposite elbow.",
    "organization": "Four reps each, then rotate.",
    "instructions": [
      "The coach shoots.",
      "The defender steps toward the attacker immediately ('Hit!').",
      "Make contact with the forearm and chest at the three-point line.",
      "Turn and hold the attacker outside the paint.",
      "Release and pursue the ball if it bounces long."
    ],
    "coachingPoints": [
      "Go to them, do not wait.",
      "Contact at the arc, not the block.",
      "Pursue after the hold."
    ],
    "commonMistakes": [
      "Watching the shot first.",
      "Letting the attacker build speed.",
      "Holding too long and missing the ball."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
    "progressions": [
      "Attacker may fake one way.",
      "Two crashing wings, two defenders."
    ],
    "regressions": [
      "Attacker jogs.",
      "Coach calls 'Shot!' before releasing."
    ],
    "variations": [
      "From the corner.",
      "Guard vs post: mismatch box-out."
    ],
    "successCriteria": [
      "Attacker kept outside the paint.",
      "Contact made within one step."
    ],
    "gameApplication": "Crashing wings get the most offensive rebounds; stopping them early is the fix.",
    "repetitions": "4 reps x 3",
