  "content": {
    "objective": "Measure shooting percentage by zone so practice time goes to the weakest areas.",
    "setup": "Five zones marked: left corner, left wing, top, right wing, right corner. Partner with a clipboard or phone.",
    "organization": "Shooter, passer-rebounder and charter rotate every 50 shots.",
    "instructions": [
      "Take ten catch-and-shoot attempts from the first zone.",
      "The charter marks each make and miss for that zone.",
      "Move through all five zones.",
      "Add up the percentage for each zone.",
      "Pick the weakest zone as homework for the week."
    ],
    "coachingPoints": [
      "Game shots only: same range and speed you shoot in games.",
      "Honest charting: no re-dos.",
      "Compare zones, not players."
    ],
    "commonMistakes": [
      "Shooting from inside the zone to boost the numbers.",
      "Rushing to finish fifty quickly.",
      "Not recording misses."
    ],
    "safety": "Shooters rebound their own ball only when the lane is clear; nobody stands under the rim while others shoot.",
    "progressions": ["Chart off-the-dribble shots too.", "Repeat monthly and compare charts."],
    "regressions": ["Twenty-five shots (five per zone).", "Mid-range zones only."],
    "variations": ["Chart free throws in sets of ten.", "Chart shots in a scrimmage."],
    "successCriteria": [
      "Chart completed for all five zones.",
      "Weakest zone identified and noted."
    ],
    "gameApplication": "Players who know their percentages choose better shots in games.",
