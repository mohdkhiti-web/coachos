  "content": {
    "objective": "Read how the defender plays a down screen and use the right cut to get a clean shot.",
    "setup": "Passer at the wing; screener at the elbow; shooter at the block; a defender on the shooter.",
    "organization": "Rotate shooter, screener, defender, passer.",
    "instructions": [
      "The screener steps down toward the block and sets the screen on the shooter's defender.",
      "The shooter waits, walks the defender into the screen, then cuts.",
      "Defender trailing: curl tight around the screen toward the lane.",
      "Defender cheating under: fade (flare) out behind the screen.",
      "Defender behind: straight up to the top; catch and shoot."
    ],
    "coachingPoints": [
      "Set up the cut: wait for the screen, then go.",
      "Shoulder to hip with the screener.",
      "Read the defender, not the passer."
    ],
    "commonMistakes": [
      "Cutting before the screen is set (moving screen).",
      "Same cut every time.",
      "Wide cuts that let the defender through."
    ],
    "safety": "Screens are legal: screener's feet set, arms in.",
    "progressions": [
      "Screener rolls or slips after the screen.",
      "Add a defender on the screener."
    ],
    "regressions": ["Defender shows the read on purpose.", "Straight cut only."],
    "variations": ["Flare screen from the top.", "Stagger with two screeners."],
    "successCriteria": [
      "Correct cut for the defender's position on most reps.",
      "Catch and shoot in rhythm."
    ],
    "gameApplication": "Shooters get open off screens; reading the defender decides whether the shot is open or contested.",
    "repetitions": "8 reps",
