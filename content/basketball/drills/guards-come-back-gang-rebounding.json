    "objective": "Win team rebounds by combining big-man box-outs with guards crashing in to secure the ball.",
    "setup": "3v3 with two posts and a perimeter player per team; coach shoots from the top.",
    "organization": "Defense stays on for three shots; rotate.",
    "instructions": [
      "The coach shoots.",
      "The two bigs box out the offensive bigs and hold.",
      "The defensive guard boxes the offensive guard, then releases inward.",
      "The guard sprints to the ball and secures it.",
      "Rebound counts only if a guard or a big secures it cleanly."
    ],
    "coachingPoints": [
      "Bigs hold, guards get.",
      "Release after contact, not before.",
      "Call 'Mine!'."
