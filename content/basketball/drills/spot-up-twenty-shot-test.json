  "content": {
    "objective": "Measure catch-and-shoot accuracy in a consistent format to track improvement over time.",
    "setup": "Four marked spots: both elbows and both wings at mid-range (or three-point range for older players). A passer with a ball.",
    "organization": "One shooter, one passer-rebounder; record the score.",
    "instructions": [
      "Five shots from the right wing, catching from the passer.",
      "Five from the right elbow.",
      "Five from the left elbow.",
      "Five from the left wing.",
      "Record makes out of 20; repeat next week from the same spots."
    ],
    "coachingPoints": [
      "Same rhythm on every shot.",
      "Do not rush: it is a test, not a race.",
      "Track honestly: no re-dos."
    ],
    "commonMistakes": [
      "Changing the distance between tests.",
      "Shooting tired from another drill without noting it.",
      "Rushing to finish."
    ],
    "safety": "Shooters rebound their own ball only when the lane is clear; nobody stands under the rim while others shoot.",
    "progressions": ["Move the spots out to three-point range.", "Two-minute time limit."],
    "regressions": ["Ten shots, two spots.", "Shoot from inside the lane."],
    "variations": [
      "Test off the dribble instead of the catch.",
      "Test with the weak-side passer for different angles."
    ],
    "successCriteria": ["Score recorded every week.", "Improvement over the season."],
    "gameApplication": "Players and coaches see shooting progress in numbers instead of guesses.",
    "repetitions": "1 test of 20 shots",
