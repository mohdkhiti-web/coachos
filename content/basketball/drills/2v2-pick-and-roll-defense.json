  "content": {
    "objective": "Defend a live ball screen using the called coverage — hedge, drop or switch — communicated clearly between both defenders.",
    "setup": "An offensive ball handler and screener run a live ball screen against two defenders.",
    "organization": "",
    "instructions": [
      "The coach calls the coverage before the rep: hedge, drop, or switch.",
      "Both defenders communicate the call out loud as the screen approaches.",
      "They execute the coverage, containing the ball handler without fouling.",
      "Reset with a new coverage called for the next rep."
    ],
    "coachingPoints": [
      "Call the coverage early and loudly, not after the screen arrives.",
      "On a switch, communicate clearly who has who.",
      "Stay low and balanced regardless of which coverage is used."
    ],
    "commonMistakes": [
      "Both defenders assuming the other has the switch, leaving someone open.",
      "Hedging too hard and losing the screener on the roll.",
      "Talking too little for teammates to react in time."
    ],
    "safety": "Screens must be legal and defenders should avoid unnecessary contact when fighting through.",
