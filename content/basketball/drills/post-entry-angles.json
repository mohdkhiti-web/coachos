  "content": {
    "objective": "Feed the post safely by improving the angle and passing to the post's target hand.",
    "setup": "Wing passer and wing defender; post player and post defender (three-quarter fronting).",
    "organization": "Rotate every four entries.",
    "instructions": [
      "The post seals and shows a target hand.",
      "If the defender fronts high, dribble down toward the baseline to improve the angle.",
      "If the defender is behind, pass to the target hand with a bounce or a direct pass.",
      "If fronted, lob over the top only with weak-side help cleared.",
      "The post catches and holds the seal."
    ],
    "coachingPoints": [
      "Pass to the hand, away from the defender.",
      "Dribble to improve the angle.",
      "Pass fake to move the wing defender's hands."
    ],
