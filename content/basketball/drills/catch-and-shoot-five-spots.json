  "content": {
    "objective": "Catch the ball ready to shoot and release quickly with no wasted dribble.",
    "setup": "A passer feeds the shooter at each of five spots around the arc in turn.",
    "organization": "",
    "instructions": [
      "The shooter squares up before the catch, feet already pointed at the basket.",
      "Catch and shoot in one motion with no dribble.",
      "Make five at each spot before moving to the next.",
      "The passer and shooter switch roles after completing all five spots."
    ],
    "coachingPoints": [
      "Have the feet ready before the ball arrives.",
      "Catch with the hands already shaped for the shot.",
      "Shoot on the hop or a one-two step, not a flat-footed catch."
    ],
    "commonMistakes": [
      "Taking an extra dribble out of habit after catching.",
      "Squaring up after the catch instead of before.",
      "Letting the elbow drift out to the side instead of staying under the ball."
    ],
    "safety": "Keep the passer out of the shooter's landing path.",
