  "content": {
    "objective": "Learn the pass-cut-fill rule so three players keep good spacing and create lay-ups without set plays.",
    "setup": "Three players at the top and both wings; no defense at first.",
    "organization": "Continuous for one minute, then add defenders.",
    "instructions": [
      "The top passes to a wing.",
      "The passer cuts hard to the basket, hand up.",
      "If not open, they exit to the empty wing.",
      "The other wing fills the top.",
      "Repeat from the new spots."
    ],
    "coachingPoints": [
      "Pass then cut, every time.",
      "Fill the empty spot.",
      "Hand up on the cut."
    ],
    "commonMistakes": [
      "Standing after the pass.",
      "Two players in the same spot.",
      "Cutting slowly."
    ],
    "safety": "Cutters keep their eyes up so they do not run into each other under the basket.",
    "progressions": [
      "Passive then live defense.",
      "Four players (4-out)."
    ],
    "regressions": [
      "Coach points to the spot to fill.",
      "Cones for the three spots."
    ],
    "variations": [
      "Cut must be a backdoor if overplayed.",
      "Score only from a cut."
    ],
    "successCriteria": [
