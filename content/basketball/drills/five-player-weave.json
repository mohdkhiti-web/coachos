  "content": {
    "objective": "Pass and run behind the receiver in a five-lane pattern at speed, without travelling, finishing with a lay-up.",
    "setup": "Five lines across the baseline: both corners, both blocks and the middle.",
    "organization": "One group of five at a time; the next group starts when the first reaches half court.",
    "instructions": [
      "The middle player passes to the right block player and runs behind them.",
      "The receiver passes to the next player coming toward the middle and runs behind that player.",
      "Keep passing and running behind the receiver, filling the outside lane.",
      "No dribbling; three steps maximum with the ball.",
      "The player who catches inside the far free-throw line finishes."
    ],
    "coachingPoints": [
      "Pass and go behind: always behind the player you passed to.",
      "Lead passes into the space ahead.",
      "Communicate: call names and 'behind'."
    ],
    "commonMistakes": [
      "Running in front of the receiver and blocking the lane.",
      "Bunching up in the middle.",
      "Travelling on the catch."
    ],
    "safety": "Groups learn the four-player and three-player weave before adding the fifth player.",
    "progressions": [
      "Back down the court with a 3v2.",
      "Set a target number of passes per length."
    ],
    "regressions": ["Three-player weave first.", "Walk the pattern."],
    "variations": ["Finish with a jump shot from the elbow.", "Two balls in the group."],
    "successCriteria": [
      "Completes the length without a travel or a dropped pass.",
      "Finishes the lay-up."
    ],
    "gameApplication": "The weave trains the timing and communication that fast breaks with several runners need.",
    "repetitions": "4 trips per group",
