    "objective": "Warm up with agility and decision-making by moving only on court lines while avoiding a tagger.",
    "setup": "All players on court lines; one or two taggers with bibs.",
    "organization": "Rounds of 60 seconds; tagged players become taggers.",
    "instructions": [
      "Players may only move along the painted lines.",
      "Taggers also stay on lines.",
      "Tagged players freeze, then swap with the tagger.",
      "Coach calls the movement: run, slide or backpedal.",
      "Change taggers every round."
    ],
    "coachingPoints": [
      "Eyes up, look for space.",
      "Change direction sharply.",
      "Stay on the lines."
    ],
    "commonMistakes": [
      "Cutting across off the lines.",
      "Running into others.",
      "Pushing when tagging."
    ],
    "safety": "Tags are a light touch on the shoulder or back; players watch for others at line junctions.",
    "progressions": ["Dribble a ball while moving.", "More taggers."],
    "regressions": ["Walking only.", "Larger area."],
    "variations": ["Freeze tag with release by a high five.", "Team tag."],
    "successCriteria": ["Everyone moving all round.", "Safe tagging."],
