  "content": {
    "objective": "Read the defender on a hand-off: shoot behind the screen when they go under, turn the corner when they trail.",
    "setup": "Big with the ball at the right elbow; shooter at the right corner; defender on the shooter.",
    "organization": "Rotate shooter, big, defender.",
    "instructions": [
      "The shooter runs from the corner toward the big's outside hip.",
      "The big hands the ball off and turns into a screen.",
      "Defender goes under: shoot behind the hand-off.",
      "Defender trails: turn the corner to the rim or pull up.",
      "Play it live for two seconds after the hand-off."
    ],
    "coachingPoints": [
      "Run tight: shoulder to the big's hip.",
      "Catch in the shooting pocket ready to rise.",
      "Read the defender's path, not the ball."
    ],
    "commonMistakes": [
      "Wide approach that lets the defender slide through.",
      "Big tossing instead of handing.",
      "Shooting when the defender trails right behind."
    ],
    "safety": "Big sets a stationary screen after the hand-off.",
    "progressions": ["Defend the big too.", "Add a help defender at the rim."],
    "regressions": ["Hand-off without a defender.", "Shoot behind every time."],
    "variations": ["Hand-off at the top.", "Fake hand-off and big keeps it."],
    "successCriteria": ["Correct read on most reps.", "Shot taken in rhythm."],
    "gameApplication": "Hand-offs give shooters a moving screen and a ball at the same time.",
