  "content": {
    "objective": "Recognise where the double team came from and pass to the player left open, quickly and away from the defense.",
    "setup": "Post player on the right block; perimeter players at the right wing, top and left wing; two defenders.",
    "organization": "Rotate positions every four reps.",
    "instructions": [
      "The wing passes to the post player, who catches with a strong two-hand grip.",
      "One defender guards the post; the second comes to double from the wing or top.",
      "The post pivots to see the floor and reads where the double came from.",
      "Pass to the player whose defender doubled (often the passer who relocates).",
      "That player catches and shoots."
    ],
    "coachingPoints": [
      "Chin the ball and look over the shoulder to the middle.",
      "The open player is usually where the double came from.",
      "Perimeter players relocate after passing to the post."
    ],
    "commonMistakes": [
      "Dribbling into the double team.",
      "Passing back over the defenders' heads.",
      "Holding the ball too long."
    ],
    "safety": "Double teams play the ball; no hacking or pinning the post player's arms.",
    "progressions": [
      "Third defender who rotates to the open pass.",
      "Double comes at random times."
    ],
    "regressions": [
      "Coach announces where the double comes from.",
      "Defenders' hands behind backs."
    ],
    "variations": [
      "High-post catch and kick to the corner.",
      "Post kicks out, then reposts for a re-entry."
    ],
    "successCriteria": [
      "Correct receiver on 8 of 10 doubles.",
      "Pass within two seconds of the double arriving."
    ],
    "gameApplication": "Post players who pass out of doubles make the double team costly for the defense.",
    "repetitions": "8 reps per post player",
