  "content": {
    "objective": "Contain the ball handler and the roller with two defenders by dropping the big and chasing with the guard.",
    "setup": "Ball handler and screener at the top; two defenders.",
    "organization": "Rotate pairs.",
    "instructions": [
      "The big's defender drops to the level of the free-throw line as the screen comes.",
      "Stay in front of the ball handler's path to the rim while staying close to the roller.",
      "The on-ball defender chases over the screen and pressures from behind.",
      "The big contests a pull-up only when the ball handler is close.",
      "Recover to the roller when the guard is back."
    ],
    "coachingPoints": [
      "Big stays between ball and rim.",
      "Guard chases tight to take away the pull-up.",
      "Big's hands active in the pocket pass lane."
    ],
    "commonMistakes": [
      "Big dropping too deep and giving free floaters.",
      "Guard going under and giving a three.",
      "Big committing to the ball and leaving the roller."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Pick-and-pop screener.",
      "Add weak-side helpers."
    ],
    "regressions": [
      "Walk-through.",
      "No pull-ups allowed."
    ],
    "variations": [
      "Drop on a side screen.",
      "Drop with a 'stunt' at the ball."
    ],
    "successCriteria": [
      "Few rim attempts.",
      "Pull-ups contested."
    ],
    "gameApplication": "Drop coverage protects the rim at the price of mid-range shots, a common modern trade-off.",
