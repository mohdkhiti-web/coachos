  "content": {
    "objective": "Stop a cutter's path through the lane with a legal body bump and stay between cutter and ball.",
    "setup": "Passer at the wing; cutter at the weak-side wing; defender on the cutter.",
    "organization": "Rotate roles.",
    "instructions": [
      "The passer holds the ball at the right wing.",
      "The cutter tries to cut through the lane to the ball side.",
      "The defender steps into the cutter's path with the chest, arms in.",
      "Redirect the cutter behind (away from the ball).",
      "Play live if the pass is made."
    ],
    "coachingPoints": [
      "Beat the cutter to the spot.",
      "Chest, not arms or hips.",
      "Stay ball-side after the bump."
    ],
    "commonMistakes": [
      "Holding or grabbing the cutter.",
      "Letting the cutter go in front.",
      "Bumping with an extended arm."
    ],
    "safety": "Chest contact only with arms in; no shoving.",
    "progressions": ["Cutter may go back door.", "Add a second cutter."],
    "regressions": ["Cutter jogs.", "Cone as cutter path."],
    "variations": ["Bump the flash cut to the high post.", "Bump a curl off a screen."],
    "successCriteria": ["Cutter rerouted on most reps.", "No holding fouls."],
    "gameApplication": "Cutters who pass freely through the lane get easy baskets; bumping them breaks the timing.",
    "repetitions": "6 reps per defender",
