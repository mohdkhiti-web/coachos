  "content": {
    "objective": "Recognise and move into the gaps of a zone so the shot is open before the zone shifts.",
    "setup": "Five defenders in a 2-3 zone (standing first, then moving); three shooters around the perimeter.",
    "organization": "Shooters rotate through spots; defenders shift on each pass.",
    "instructions": [
      "The zone defenders hold their positions.",
      "Shooters stand in the gaps: between the two top defenders, and between top and wing defenders.",
      "Pass around; each receiver catches and shoots if the gap is still open.",
      "Next round, the zone shifts toward the ball; shooters must re-find gaps.",
      "Score team makes."
    ],
    "coachingPoints": [
      "Stand between two defenders, not in front of one.",
      "Shift as the ball moves.",
      "Catch ready to shoot."
    ],
    "commonMistakes": [
      "Standing directly in front of a zone defender.",
      "Holding the ball while the zone shifts.",
      "Passing around the perimeter too slowly."
    ],
    "safety": "Defenders contest without contact.",
    "progressions": ["Zone defends live.", "Add a high-post player."],
    "regressions": [
      "Zone defenders stand still and hold their arms out.",
      "Shoot from the free-throw line extended."
    ],
    "variations": ["1-3-1 zone gaps.", "Gap shot or gap drive."],
    "successCriteria": ["Shots taken from gaps on most possessions.", "Team target of makes."],
    "gameApplication": "Zones leave gaps between defenders; shooters who stand in them get open shots.",
    "repetitions": "8 possessions",
