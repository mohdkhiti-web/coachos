    "objective": "Keep good floor balance while passing and cutting continuously with no defense pressuring yet.",
    "setup": "Five players space out around the perimeter, one ball to start.",
    "organization": "",
    "instructions": [
      "Pass the ball to any open teammate and cut toward the basket.",
      "A teammate not involved in the cut fills the vacated spot.",
      "Continue passing, cutting and filling continuously for two minutes.",
      "Add a coach calling 'reverse' to force the ball the opposite direction occasionally."
    ],
    "coachingPoints": [
      "Keep the five spots balanced at all times — never bunch two players together.",
      "Cut with purpose, not just to be moving.",
      "Fill spots promptly so spacing never collapses."
    ],
    "commonMistakes": [
      "Two players drifting to the same spot after a cut.",
      "Standing still after a pass instead of cutting or filling.",
      "Crowding a teammate's space instead of keeping good spacing."
    ],
    "safety": "Keep the whole perimeter clear of equipment so cutting lanes stay open.",
