  "content": {
    "objective": "Overload one side of a zone by running a player along the baseline as the ball is reversed.",
    "setup": "Offense in a 1-3-1 against a 2-3 zone; baseline runner starts in one corner.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "The ball is on the right side; the runner is in the right corner.",
      "Reverse the ball to the left via the top.",
      "The runner runs the baseline to the left corner, using the bigs as screens.",
