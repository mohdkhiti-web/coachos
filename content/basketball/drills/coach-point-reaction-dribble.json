  "content": {
    "objective": "React to a visual signal with the correct change of direction, keeping control and the head up.",
    "setup": "Players in rows facing the coach, a ball each, with two metres of space all around.",
    "organization": "Whole group reacts at once.",
    "instructions": [
      "Players dribble in an athletic stance.",
      "Coach points left or right: crossover and take two hard dribbles that way.",
      "Coach points forward: attack two dribbles forward.",
      "Coach points back: two retreat dribbles.",
      "Coach raises a fist: jump-stop and pivot to face the coach."
    ],
    "coachingPoints": [
      "React to the arm, not the voice.",
      "Every move ends low and balanced, ready for the next one.",
      "Change hands so the ball is always on the side away from the movement direction you came from."
    ],
    "commonMistakes": [
      "Watching other players and copying them late.",
      "Making the move without moving the feet.",
      "Losing balance on the retreat."
    ],
    "safety": "Keep rows staggered so two-dribble moves never collide; do not point players toward each other.",
    "progressions": [
      "Add a fake: the coach points one way and then the other quickly.",
      "Partners take the coach role."
    ],
    "regressions": ["Use only left and right.", "Call the direction as well as pointing."],
    "variations": [
      "Finish each sequence with a shot when the coach points at the rim.",
      "Use coloured cards for directions."
    ],
    "successCriteria": [
      "Moves the correct way within half a second of the signal.",
      "No lost balls over a 45-second round."
    ],
    "gameApplication": "Ball handlers react to the defender's feet and hands; this trains that reaction with a simple signal.",
    "repetitions": "4 rounds of 45 s",
