  "content": {
    "objective": "Prevent lobs and post seals off back and cross screens by communicating and choosing a coverage early.",
    "setup": "Two offensive bigs on the blocks (cross screen) or a big and a guard at the elbow and wing (back screen); a passer.",
    "organization": "Rotate roles.",
    "instructions": [
      "Cross screen: one big screens across the lane for the other.",
      "The screener's defender calls the screen early.",
      "The cutter's defender fights over the top (high side) to deny the post seal.",
      "Back screen: the screener's defender opens up to see and help on the lob.",
      "Switch when the call is made."
    ],
    "coachingPoints": [
      "Early call, before contact.",
      "High side on cross screens.",
      "Open up to the ball on back screens."
    ],
    "commonMistakes": [
      "Turning the back to the ball on the back screen.",
      "Getting sealed under the cross screen.",
      "Late switches that give a lob."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Add a weak-side helper.",
      "Offense reads and slips."
    ],
    "regressions": [
      "Walk-through.",
      "No lob allowed."
    ],
    "variations": [
      "Defend a flex screen.",
      "Defend the UCLA cut."
    ],
    "successCriteria": [
      "No lobs conceded.",
      "No deep post seals."
    ],
    "gameApplication": "Screens near the rim lead to the easiest baskets; early calls stop them.",
    "repetitions": "8 reps",
