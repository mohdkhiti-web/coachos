  "content": {
    "objective": "Use a two-screen stagger to lose a defender and catch square for a shot.",
    "setup": "Passer at the right wing; screeners at the left block and left elbow; shooter under the basket.",
    "organization": "Rotate shooter, screeners and passer.",
    "instructions": [
      "The shooter starts under the basket and sets up the defender toward the baseline.",
      "The first screener at the block screens; the second at the elbow screens just after.",
      "The shooter runs tight off both screens to the left slot.",
      "The passer passes as the shooter clears the second screen.",
      "Catch, square, shoot."
    ],
    "coachingPoints": [
      "Set the defender up before using the screens.",
      "Run tight off each screener's hip.",
      "Screeners hold until the shooter passes."
    ],
    "commonMistakes": [
      "Cutting before the screens are set.",
      "Wide cuts between screens.",
      "Screeners moving into the shooter's path."
    ],
    "safety": "Screeners stationary with arms in.",
    "progressions": ["Defender chases the shooter.", "Shooter curls the second screen if trailed."],
    "regressions": ["One screener only.", "No defender."],
    "variations": ["Stagger to the corner.", "Screener pops after the stagger."],
    "successCriteria": [
