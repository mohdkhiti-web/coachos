  "content": {
    "objective": "Use stance angle and foot position to force the ball in the direction the team defense wants.",
    "setup": "Offense catches at the wing; defender closes out.",
    "organization": "Live 1v1; switch roles each possession.",
    "instructions": [
      "The coach calls the direction to force.",
      "The defender closes out with the inside foot forward to force baseline (or outside foot to force middle).",
      "The ball handler attacks.",
      "The defender keeps the angle and cuts off the other way.",
      "Score: defender wins a point if the ball goes the forced direction and no score results."
    ],
    "coachingPoints": [
      "Angle the stance before the dribble.",
      "Give the direction, take away the other.",
      "Stay attached as they go."
    ],
    "commonMistakes": [
      "Square stance with no angle.",
      "Over-forcing and allowing a straight-line drive.",
      "Turning the head away."
    ],
    "safety": "Defenders play legally: chest up, no reaching across the body, no pushing; stop play on any dangerous contact.",
    "progressions": ["Add a helper who arrives on baseline drives.", "Offense may cross back."],
    "regressions": ["Dribbler goes at half speed.", "Coach demonstrates the angle."],
    "variations": ["Force from the top to a side.", "Force weak hand."],
    "successCriteria": [
      "Ball goes the forced direction most possessions.",
      "Low scoring for the offense."
    ],
    "gameApplication": "Team defenses only work when individuals force the ball where help is waiting.",
    "repetitions": "6 possessions per player",
