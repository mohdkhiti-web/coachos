  "content": {
    "objective": "Set a stationary, legal screen with a wide base and correct body position.",
    "setup": "Groups of three: screener, cutter and a stand-in defender (or cone).",
    "organization": "Rotate roles every four reps.",
    "instructions": [
      "The screener jogs toward the defender.",
      "Jump-stop into a wide stance one step from the defender.",
      "Arms crossed at the chest or hands at the waist.",
      "Hold still while the cutter brushes past.",
      "After the cutter passes, roll or pop away."
    ],
    "coachingPoints": [
      "Stop before contact: the defender must run into you.",
      "Wide base, knees bent.",
      "Hold until the cutter is past."
    ],
    "commonMistakes": [
      "Moving into the defender (moving screen).",
      "Sticking out a hip or leg.",
      "Leaving the screen too early."
    ],
    "safety": "Screeners keep arms in; defenders brush past without charging.",
    "progressions": ["Live defender who fights through.", "Screener reads to roll or pop."],
    "regressions": ["Screen a cone.", "Walk-through."],
    "variations": [
      "Down screen footwork.",
      "Back screen footwork (one step away from blind defender)."
    ],
    "successCriteria": ["Stationary at contact every rep.", "No arms or hips extended."],
    "gameApplication": "Legal screens free teammates without giving away offensive fouls.",
    "repetitions": "4 reps per role",
