  "content": {
    "objective": "Find a balanced athletic stance instantly: feet wider than shoulders, knees bent, back flat, hands ready.",
    "setup": "Players spread over the half court.",
    "organization": "Whole group.",
    "instructions": [
      "Jog in any direction.",
      "On the whistle, freeze in an athletic stance.",
      "The coach walks around and gives each player one correction.",
      "On 'offense', hold the ball position (triple threat); on 'defense', hands out and active.",
      "Repeat with faster whistles."
    ],
    "coachingPoints": [
      "Weight on the balls of the feet.",
      "Knees bent, hips back, chest up.",
      "Hands ready: no hands on knees."
    ],
    "commonMistakes": [
      "Standing straight-legged.",
      "Bending at the waist instead of the knees.",
      "Feet too close together."
    ],
    "safety": "Use a clear, dry floor and space players so nobody collides when changing direction.",
    "progressions": [
      "Hold the stance for ten seconds.",
      "Push test: a partner gently nudges to check balance."
    ],
    "regressions": ["Mirror the coach's stance first.", "Shorter jogs."],
    "variations": ["Freeze on a colour call.", "Freeze, then slide two steps."],
    "successCriteria": [
      "Correct stance within one second of the whistle.",
      "Holds balance when nudged gently."
    ],
    "gameApplication": "Every move, catch and defensive slide starts from a balanced stance.",
    "repetitions": "8 to 10 freezes",
