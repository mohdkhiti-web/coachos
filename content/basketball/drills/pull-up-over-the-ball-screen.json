  "content": {
    "objective": "Read drop coverage and punish it with a pull-up jumper over the screen.",
    "setup": "Ball handler at the top; screener at the right slot; screener's defender plays drop near the free-throw line.",
    "organization": "Rotate ball handler, screener and defender.",
    "instructions": [
      "The screener sets a ball screen at the top.",
      "The ball handler comes off the screen tight.",
      "The screener's defender sits back in the lane (drop).",
      "Pull up on one or two dribbles at the free-throw line or behind the arc.",
      "If the drop defender steps up, hit the rolling screener."
    ],
    "coachingPoints": [
      "Come off the screen shoulder to hip.",
      "Get to the shot before the defender recovers.",
      "Read the big, not your own defender."
    ],
    "commonMistakes": [
      "Driving into the drop defender.",
      "Pulling up too late after the big steps up.",
      "Wide path off the screen."
    ],
    "safety": "Screen legal and stationary; defenders do not undercut the shooter.",
    "progressions": ["Defender chases over the screen from behind.", "Pull-up three."],
    "regressions": ["No defender on the ball handler.", "Drop defender stays fixed."],
