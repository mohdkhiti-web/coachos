  "content": {
    "objective": "Break a zone by attacking gaps to draw two defenders and moving the ball faster than the zone shifts.",
    "setup": "Offense in a 1-3-1 or 2-1-2 alignment against a 2-3 zone.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "The top player dribbles into the gap between the two top defenders.",
      "Both defenders step up.",
      "Pass to the wing whose defender committed.",
      "The wing attacks the next gap or skips to the far side.",
      "Score from the open spot."
    ],
    "coachingPoints": [
      "Attack the gap, not the defender.",
      "Pass when two commit.",
      "Skip when the zone over-shifts."
    ],
