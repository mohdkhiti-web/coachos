  "content": {
    "objective": "Force the ball out of the ball handler's hands with a trap and rotate behind it to take away the easy pass.",
    "setup": "4v4 with a ball screen at the top; two weak-side defenders.",
    "organization": "Rotate offense and defense.",
    "instructions": [
      "Both defenders trap the ball handler as the screen is set.",
      "Trap with high hands and the feet stopping the split.",
      "The low weak-side defender rotates to the short roll.",
      "The other weak-side defender splits the two weak-side shooters.",
      "Play live."
    ],
    "coachingPoints": [
      "Trap high and tight, no gap to split.",
      "Hands up to stop the pass over the top.",
      "Rotate on the pass out of the trap."
    ],
    "commonMistakes": [
      "Trapping with low hands.",
      "Leaving a gap between trappers.",
      "Weak side not rotating."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
