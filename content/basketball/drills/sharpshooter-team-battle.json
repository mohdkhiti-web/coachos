  "content": {
    "objective": "Build shooting accuracy within a team-based competitive scoring format.",
    "setup": "Two teams alternate players shooting from the same three or five designated spots.",
    "organization": "",
    "instructions": [
      "One player from each team shoots from spot one, alternating turns.",
      "Move through all designated spots, tracking each team's total makes.",
      "Complete three full rounds through all spots.",
      "The team with the most total makes across all three rounds wins."
    ],
    "coachingPoints": [
      "Keep the same shooting mechanics regardless of which team is currently ahead.",
      "Support and encourage teammates between turns.",
      "Rebound quickly to keep the pace of the competition moving."
    ],
    "commonMistakes": [
      "Rushing shots when behind instead of staying with the normal routine.",
      "Standing around instead of rebounding promptly for the next shooter.",
      "Rushing decisions just because the format feels competitive."
    ],
    "safety": "Keep both teams' shooting lines clearly separated to avoid collisions.",
