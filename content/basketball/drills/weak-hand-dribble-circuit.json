  "content": {
    "objective": "Build confidence and control with the weak hand through repeated, varied touches in a short circuit.",
    "setup": "Four stations in the half court: pound spot, zig-zag cones, figure-eight cones and the rim.",
    "organization": "Groups of two to five per station; rotate every 90 seconds.",
    "instructions": [
      "Station 1: 30 hard pound dribbles at knee height, then 30 at waist height, weak hand only.",
      "Station 2: zig-zag between four cones, weak hand only, changing direction without switching hands (inside-out).",
      "Station 3: figure-eight around two cones with the weak hand.",
      "Station 4: weak-hand lay-ups from the weak side, five makes.",
      "Rotate on the whistle."
    ],
    "coachingPoints": [
      "Same quality as the strong hand: fingertips, low, eyes up.",
      "Go slower if needed, but never switch hands.",
      "Finish lay-ups off the correct foot."
    ],
    "commonMistakes": [
      "Sneaking the strong hand in to save the ball.",
      "Dribbling too high with the weak hand.",
      "Rushing the lay-up off the wrong foot."
    ],
    "safety": "Stations spaced well apart; the lay-up station rebounds its own balls only.",
    "progressions": ["Time each station and count reps.", "Add a defender at the lay-up station."],
    "regressions": ["Shorter stations (60 s).", "Allow two hands to catch and restart."],
    "variations": [
      "Swap station 3 for a tennis-ball toss and catch.",
      "Add a pull-up shot station."
    ],
    "successCriteria": [
      "Completes every station without switching hands.",
      "Five weak-hand lay-ups made from the correct foot."
    ],
    "gameApplication": "Defenders overplay the strong hand; a reliable weak hand opens both sides of the floor.",
    "repetitions": "One full circuit (4 x 90 s), twice",
