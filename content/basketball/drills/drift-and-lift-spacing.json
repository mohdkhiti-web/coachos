  "content": {
    "objective": "Move away from drives in a way that creates a passing lane: drift on baseline drives, lift on middle drives.",
    "setup": "Four players: top, two wings, corner; defense added later.",
    "organization": "Coach calls the drive direction; live after four reps.",
    "instructions": [
      "A wing drives baseline.",
      "The corner on that side drifts up to the 45 behind the driver.",
      "A wing drives middle: the weak-side wing lifts to the slot.",
      "The driver passes to the player who moved.",
      "Shoot or attack again."
    ],
    "coachingPoints": [
      "Move when the driver moves.",
      "Stay behind the line of the ball.",
      "Give a clear passing angle."
    ],
