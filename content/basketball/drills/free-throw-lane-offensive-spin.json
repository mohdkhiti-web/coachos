  "content": {
    "objective": "Win inside position on a missed free throw by spinning off or stepping across the inside defender.",
    "setup": "Shooter at the line; an offensive player in the second lane space; a defender inside.",
    "organization": "Five misses each, then switch roles.",
    "instructions": [
      "Coach (or shooter) deliberately misses.",
      "On the release, the attacker steps the inside foot across the defender's front foot.",
      "If the defender seals, spin off the contact toward the middle.",
      "Get a hand on the ball: catch or tip back to the shooter.",
      "Score if possible."
    ],
    "coachingPoints": [
      "Move on the release.",
      "Step across or spin; never push.",
      "Middle of the lane is the target."
    ],
    "commonMistakes": [
      "Waiting to see the miss.",
      "Pushing the defender (foul).",
      "Spinning away from the rim."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
    "progressions": [
      "Two attackers vs two defenders.",
      "Shooter crashes too."
    ],
    "regressions": [
