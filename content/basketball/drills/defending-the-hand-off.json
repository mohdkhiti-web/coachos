  "content": {
    "objective": "Defend a dribble hand-off with the coverage the coach calls, without giving a free shot or drive.",
    "setup": "Big with the ball at the elbow extended; guard at the wing; two defenders.",
    "organization": "Coach calls the coverage each rep.",
    "instructions": [
      "The coach calls 'switch', 'under' or 'jump'.",
      "Switch: both defenders swap at the hand-off.",
      "Under: the guard's defender goes under the big against a non-shooter.",
      "Jump: the big's defender jumps into the receiver's path to stop the hand-off.",
      "Play live after the hand-off."
    ],
    "coachingPoints": [
      "Know the call before the action.",
      "Talk at the hand-off.",
      "Recover to your man after the action."
    ],
    "commonMistakes": [
      "Mixed coverages with no call.",
      "Going under against a shooter.",
      "Jumping late and fouling."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Random coverage chosen by the defense.",
      "Add a weak-side shooter."
    ],
    "regressions": [
      "Walk-through.",
      "One coverage per round."
    ],
    "variations": [
      "Defend a fake hand-off (keeper).",
      "Defend a hand-off at the top."
    ],
    "successCriteria": [
      "Coverage executed correctly on most reps.",
      "No uncontested shots."
    ],
    "gameApplication": "Hand-offs are a staple of modern offenses; defenses need a plan for them.",
