  "content": {
    "objective": "Pass accurately at a target from different distances, stepping into every pass.",
    "setup": "Two teams on opposite sides of the lane, each with five tall cones behind its own line.",
    "organization": "Two teams; balls start in the middle.",
    "instructions": [
      "Players stand behind their team's line and pass balls at the other team's cones.",
      "Use chest or bounce passes only (no throwing overhead).",
      "Players may stop balls with their hands but may not stand in front of the cones.",
      "A knocked cone stays down.",
      "The first team to knock down all the other team's cones wins."
    ],
    "coachingPoints": [
      "Step toward the target and follow through.",
      "Aim low for bounce passes.",
      "Get the ball back quickly and pass again."
    ],
    "commonMistakes": [
      "Throwing without stepping.",
      "Overhead throws that bounce over the cones.",
      "Everyone chasing the same ball."
    ],
    "safety": "Passes below shoulder height only; players stay behind their line.",
    "progressions": ["Move the lines further apart.", "Weak-hand one-hand passes only."],
    "regressions": ["Closer lines.", "Bigger cones or bottles."],
    "variations": [
      "Each player must pass with both chest and bounce passes.",
      "Knock cones in a set order."
    ],
    "successCriteria": ["Team knocks all cones within the time.", "Players step into every pass."],
    "gameApplication": "Young players learn that accurate passes come from stepping into the pass.",
