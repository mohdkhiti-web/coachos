  "content": {
    "objective": "Use a hard hedge to buy time for the on-ball defender, then recover to the screener before they catch.",
    "setup": "Ball handler and screener at the top; two defenders.",
    "organization": "Rotate pairs every four reps.",
    "instructions": [
      "The screener sets a ball screen.",
      "The screener's defender steps out sideways into the ball handler's path (hedge), showing hands.",
      "The ball handler is pushed wide; the on-ball defender fights over the screen.",
      "When the on-ball defender is back, the hedger sprints back to the roller.",
      "Play live."
    ],
    "coachingPoints": [
      "Hedge with the body, not the hands.",
      "Stay long enough for your teammate to get back.",
      "Recover with a hand in the passing lane."
    ],
    "commonMistakes": [
      "Hedging too far and giving a split.",
      "Recovering too early.",
      "On-ball defender going under while the big hedges."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
