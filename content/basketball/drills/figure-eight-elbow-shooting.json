    "objective": "Shoot off continuous movement with the feet set on each catch.",
    "setup": "Passer at the top with two balls; shooter starts at the left block.",
    "organization": "Shooter works 60 seconds, then swaps.",
    "instructions": [
      "Cut from the left block around the left elbow and catch at the left slot.",
      "Shoot, then cut across the lane under the basket to the right block.",
      "Come up around the right elbow, catch at the right slot and shoot.",
      "Continue the figure-eight for 60 seconds.",
      "Count makes."
    ],
    "coachingPoints": [
      "Low cut, high catch.",
      "Hop or 1-2 into every shot.",
      "Keep moving, but stop for the shot."
    ],
    "commonMistakes": [
      "Shooting while still moving sideways.",
      "Rounding the cuts and losing time.",
      "Short shots from tired legs."
    ],
    "safety": "Passer stays at the top, away from the cutting lanes.",
