  "content": {
    "objective": "Bump the rolling screener before they catch, then recover to the weak-side shooter in time.",
    "setup": "Ball screen at the top; a weak-side corner shooter; three defenders (ball, big, low man).",
    "organization": "Rotate positions.",
    "instructions": [
      "The screener's defender hedges or blitzes the ball handler.",
      "The screener rolls to the rim.",
      "The low weak-side defender steps into the roller's path (tag) with the body.",
      "As the big recovers, the tagger sprints back to the corner shooter.",
      "Play live."
    ],
    "coachingPoints": [
      "Tag in front of the roller, early.",
      "Body, not hands.",
      "Recover with a closeout on the kick."
    ],
    "commonMistakes": [
      "Tagging late after the catch.",
      "Staying with the roller too long.",
      "Not recovering to the corner."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Ball handler can skip to the corner.",
      "Add a second weak-side shooter."
    ],
    "regressions": [
      "Walk-through.",
      "Roller jogs."
    ],
    "variations": [
      "Tag from the top (nail) defender.",
      "Tag on a side pick-and-roll."
    ],
    "successCriteria": [
      "Roller does not catch near the rim.",
      "Corner shot contested."
    ],
    "gameApplication": "Every aggressive pick-and-roll coverage depends on a low man tagging the roller.",
    "repetitions": "8 reps",
