  "content": {
    "objective": "Take away the high-post catch-and-face, the weak spot of a 2-3 zone.",
    "setup": "Five defenders in a 2-3 zone; five offensive players with a flash to the high post.",
    "organization": "Rotate offense and defense every four possessions.",
    "instructions": [
      "The offense swings the ball around the perimeter.",
      "A post flashes to the free-throw line.",
      "The middle defender steps up to deny or pressure the high post.",
      "The two baseline defenders pinch in to cover the rim behind.",
      "Top defenders drop to dig at the high post on a catch."
    ],
    "coachingPoints": [
      "Middle defender steps up on the flash, not after the catch.",
      "Baseline defenders pinch, not chase.",
      "Top defenders dig the high post, then recover."
    ],
    "commonMistakes": [
      "Letting the high post face up freely.",
      "Baseline defenders staying wide.",
      "Over-helping and leaving the corners."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Offense uses a high-low pass.",
      "Short-corner player added."
    ],
    "regressions": [
      "Walk-through.",
      "Offense passes slowly."
    ],
    "variations": [
      "1-3-1 zone high-post coverage.",
      "Matchup zone version."
    ],
    "successCriteria": [
      "Few high-post catches facing the rim.",
      "High-low pass covered."
    ],
    "gameApplication": "Most 2-3 zones break down at the high post; this is the fix.",
    "repetitions": "8 possessions",
