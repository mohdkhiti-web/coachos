  "content": {
    "objective": "Change direction and hands around real bodies, keeping the ball on the side away from each 'defender'.",
    "setup": "Players stand in a straight line two metres apart down the middle of the court.",
    "organization": "One ball per line of five to eight players.",
    "instructions": [
      "The last player in the line dribbles in and out between teammates.",
      "Change hands every time you pass a teammate, keeping the ball away from them.",
      "At the front, jump-stop two metres ahead and become the new head of the line.",
      "Hand the ball back down the line to the new last player.",
      "Continue until everyone has run the snake twice."
    ],
    "coachingPoints": [
      "Ball on the outside hand as you pass each teammate.",
      "Crossover early, before you reach the teammate.",
      "Stay low around the bodies."
    ],
    "commonMistakes": [
      "Wide swerves instead of tight changes of direction.",
      "Same hand round every teammate.",
      "Bumping teammates."
    ],
    "safety": "Teammates stand still with arms down; dribblers walk or jog only.",
    "progressions": [
      "Teammates hold out an arm to tap at loose balls.",
      "Two lines race each other."
    ],
    "regressions": ["Space teammates three metres apart.", "Walk the course."],
    "variations": [
      "Behind-the-back changes only.",
      "Pass the ball to the front instead of handing it back."
    ],
    "successCriteria": [
      "Completes the snake without touching a teammate or losing the ball.",
      "Changes hands at every teammate."
    ],
    "gameApplication": "Dribbling around real bodies is closer to driving past defenders than dribbling around cones.",
