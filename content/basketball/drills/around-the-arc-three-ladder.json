  "content": {
    "objective": "Shoot consistently from all five three-point spots with a passer, under the pressure of losing progress.",
    "setup": "Five spots: both corners, both wings, top. A passer under the basket.",
    "organization": "One shooter, one passer; swap after a full ladder or four minutes.",
    "instructions": [
      "Start in the right corner; make two in a row to move to the right wing.",
      "Continue to the top, left wing and left corner.",
      "A miss after a make sends you back one spot.",
      "Then come back from the left corner to the right corner.",
      "Time the ladder and try to beat it next session."
    ],
    "coachingPoints": [
      "Same catch and footwork at every spot.",
      "Corner: feet behind the line.",
      "Breathe before the second shot of a pair."
    ],
    "commonMistakes": [
      "Rushing the second shot to finish the pair.",
      "Feet on the line in the corners.",
      "Changing form as fatigue builds."
    ],
