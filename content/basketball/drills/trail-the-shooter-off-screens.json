  "content": {
    "objective": "Navigate a down screen by trailing the shooter's hip and contesting without fouling.",
    "setup": "Passer at the wing; screener at the elbow; shooter at the block; defender on the shooter.",
    "organization": "Rotate roles.",
    "instructions": [
      "The screener sets a down screen.",
      "The defender stays attached to the shooter's hip as they cut.",
      "Go over the screen, trailing (do not go under).",
      "Contest the catch with the hand from behind the shooter.",
      "Recover to contain a drive if they put it down."
    ],
    "coachingPoints": [
      "Hip on the shooter: chase like a shadow.",
      "Squeeze between screener and shooter.",
      "High hand on the contest."
    ],
    "commonMistakes": [
      "Going under the screen and giving an open three.",
      "Running into the screener.",
      "Fouling on the contest from behind."
    ],
    "safety": "Defenders play legally: chest up, no reaching across the body, no pushing; stop play on any dangerous contact.",
    "progressions": ["Shooter reads curl or fade.", "Add the screener's defender to help."],
    "regressions": ["Shooter jogs.", "No shot: just the chase."],
    "variations": ["Stagger screens.", "Flare screen chase."],
    "successCriteria": ["Shooter rarely gets a clean look.", "No fouls on contests."],
