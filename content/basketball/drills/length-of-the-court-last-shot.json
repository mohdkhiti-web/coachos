  "content": {
    "objective": "Score from the full length of the court in under five seconds with a rehearsed plan.",
    "setup": "Inbounder on the far baseline; five seconds on the clock; defense chooses its coverage.",
    "organization": "Run three versions; rotate inbounders.",
    "instructions": [
      "Inbounder can run the baseline after a made basket (or not: coach sets it).",
      "Option 1: long pass to a catcher at the far free-throw line, who tips or passes to a shooter.",
      "Option 2: short inbound to a guard who pushes with four dribbles.",
      "The clock starts on the first touch inbounds.",
      "Shoot before the buzzer."
    ],
    "coachingPoints": [
      "Know whether you can run the baseline.",
      "Catcher goes up with two hands.",
      "Shoot on the way up, not after the buzzer."
    ],
    "commonMistakes": [
      "Throwing the long pass too low.",
      "Dribbling too many times.",
      "Shot released after time expires."
    ],
