  "content": {
    "objective": "Make quick, correct reads when the numbers advantage is smaller and closes faster than a clean 2v1.",
    "setup": "Four attackers push against three retreating defenders down the full court.",
    "organization": "",
    "instructions": [
      "The attackers space to all four lanes, keeping the floor as wide as possible.",
      "The ball handler reads which defender is late and attacks that side.",
      "Pass quickly to whichever teammate the defense leaves open.",
      "Finish or reset quickly; this advantage closes faster than a 2v1 or 3v2."
    ],
    "coachingPoints": [
      "Decide fast — a four-on-three advantage disappears quickly.",
      "Keep all four lanes spread rather than bunching toward the ball.",
      "Communicate who is open rather than guessing."
    ],
    "commonMistakes": [
      "Over-dribbling instead of passing to the open teammate immediately.",
      "Bunching two attackers in the same lane and erasing the numbers edge.",
      "Jogging back instead of sprinting to get into position."
    ],
    "safety": "Keep the full sprint lane clear of other groups training nearby.",
