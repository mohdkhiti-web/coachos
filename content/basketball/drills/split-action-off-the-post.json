  "content": {
    "objective": "Create scoring chances off a post catch by running split screens that punish defenders who help.",
    "setup": "Post at the right block; perimeter players at the right wing and top; three defenders.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "The wing enters to the post.",
      "The passer screens for the top player (or vice versa).",
      "The cutter reads: if the defender trails, curl to the rim; if they cheat, pop.",
