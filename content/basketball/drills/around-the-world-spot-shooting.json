  "content": {
    "objective": "Build consistency by requiring a make before advancing to the next spot.",
    "setup": "Five or seven spots are marked in a line along the three-point arc.",
    "organization": "",
    "instructions": [
      "Shoot from the first spot; a make advances you to the next spot.",
      "A miss means you may choose to try again or stay and attempt it next turn.",
      "Continue until every spot has been cleared with a make.",
      "In a group, players take turns one shot at a time."
    ],
    "coachingPoints": [
      "Reset the feet fully at every new spot — don't rush the setup.",
      "Keep the same shooting rhythm regardless of the spot.",
      "Stay patient; a miss is only a small setback, not a reason to rush."
    ],
    "commonMistakes": [
      "Rushing shots to catch up with a partner.",
      "Changing shooting mechanics spot to spot instead of staying consistent.",
      "Rushing the release instead of trusting the mechanics."
    ],
    "safety": "Make sure the next shooter waits clear of the current shooter's landing area.",
