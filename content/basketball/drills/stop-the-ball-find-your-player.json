  "content": {
    "objective": "Prioritise stopping the ball and protecting the paint in transition before finding your own player.",
    "setup": "4v4 at one end; coach shoots and the offense rebounds or inbounds to go the other way.",
    "organization": "Continuous for three minutes, then switch.",
    "instructions": [
      "On the change of possession, the nearest defender sprints to stop the ball.",
      "Everyone else sprints back to the paint first.",
      "Call matchups out loud: 'I've got 23!'.",
      "Match up from the inside out.",
      "Play the possession live."
    ],
    "coachingPoints": [
      "Ball first, paint second, matchups third.",
      "Talk while running back.",
      "Point to your player."
    ],
    "commonMistakes": [
      "Everyone chasing the ball.",
      "Running to your own player and leaving the paint.",
      "Silent matchups."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Offense pushes immediately.",
      "5v5 full court."
    ],
    "regressions": [
      "Offense walks the first three steps.",
      "3v3."
    ],
    "variations": [
      "Start from a made free throw.",
      "Start from a turnover."
    ],
    "successCriteria": [
      "No lay-ups in transition.",
      "Matchups called every possession."
    ],
    "gameApplication": "Transition defense decides more games than half-court schemes; the order of jobs matters.",
    "repetitions": "3 minutes x 2",
