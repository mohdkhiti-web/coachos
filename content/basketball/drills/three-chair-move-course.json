  "content": {
    "objective": "Execute three different moves against fixed 'defenders' at game speed and finish with the correct hand.",
    "setup": "Chairs at half court, the right slot and the left elbow; one line at half court on the left side.",
    "organization": "Players go one at a time; rebound your own ball and rejoin.",
    "instructions": [
      "Attack the first chair: crossover and change direction.",
      "Attack the second chair: inside-out dribble and keep the same hand.",
      "Attack the third chair: spin away from it.",
      "Finish at the rim with the hand away from the last chair.",
      "Change the order of moves every round."
    ],
    "coachingPoints": [
      "Make each move one arm-length from the chair.",
      "Accelerate after every move.",
      "Choose the finish hand away from the defender."
    ],
    "commonMistakes": [
      "Same move at every chair because it feels safe.",
      "Slowing down between chairs.",
      "Finishing with the hand next to the chair."
    ],
    "safety": "Chairs are kept outside the restricted area; finishers never run through a chair line.",
    "progressions": [
      "Live defender replaces the third chair.",
      "Time each run and set a team record."
    ],
    "regressions": ["Two chairs only.", "Jog speed with the moves walked through first."],
    "variations": [
      "Finish with a floater or pull-up.",
      "Start from the right side for the weak hand."
    ],
    "successCriteria": [
      "Correct move at every chair.",
      "Finishes with the correct hand on every run."
    ],
    "gameApplication": "Games rarely offer one defender at a time; chaining different moves at speed prepares players for help defense.",
    "repetitions": "4 to 6 runs",
