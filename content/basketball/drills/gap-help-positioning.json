  "content": {
    "objective": "Show help in the driving gap and still recover to your player on the pass.",
    "setup": "3v3 with the ball at the top, wings on both sides.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "The ball handler at the top looks to drive.",
      "Both wing defenders stand a step off their player, in the gap toward the ball.",
      "On a drive, the gap defender steps in to show help (a 'stunt').",
      "On a pass, the gap defender recovers.",
      "Play live."
    ],
    "coachingPoints": [
      "Show the gap, then recover.",
      "Hands active in the gap.",
      "Recover on the pass, not the catch."
    ],
    "commonMistakes": [
      "Standing glued to your player (no help).",
      "Sagging too far and conceding the shot.",
      "Late recovery."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Add drive-and-kick reads.",
      "4v4."
    ],
    "regressions": [
      "Walk-through.",
      "Drives at half speed."
    ],
    "variations": [
