  "content": {
    "objective": "Rotate as a chain on a baseline drive so the last open player is the furthest from the ball.",
    "setup": "4v4 with the ball at the right wing; offense in a 4-out shape.",
    "organization": "Coach directs the first drive; then live.",
    "instructions": [
      "The wing drives baseline past the on-ball defender.",
      "The weak-side low defender steps in to stop the ball outside the restricted area.",
      "The weak-side high defender sinks to the low player's man (the dunker or corner).",
      "The top defender fills toward the weak-side wing.",
      "Beaten defender sprints to recover to the open spot."
    ],
    "coachingPoints": [
      "Stop the ball before the rim.",
      "Each defender moves one man down.",
      "Talk: 'I've got ball', 'I've got low'."
    ],
    "commonMistakes": [
      "Two defenders helping on the ball.",
      "Nobody taking the low man.",
      "Beaten defender giving up."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Drive comes from either side.",
      "Offense kicks to the furthest player."
    ],
    "regressions": [
      "Walk-through with freezes.",
      "3v3 version on one side."
    ],
    "variations": [
      "Middle drive rotation.",
      "Rotation with a post player."
    ],
    "successCriteria": [
      "Ball stopped outside the restricted area.",
      "Kick-out receiver contested."
    ],
    "gameApplication": "Good teams rotate in a chain; the open player is always the hardest pass to make.",
    "repetitions": "8 possessions",
