  "content": {
    "objective": "Make a low, tight crossover with a change of speed so the ball goes from hand to hand below the knees and away from a defender.",
    "setup": "Five gates (two cones a metre apart) are set in a zig-zag from the baseline to half court.",
    "organization": "One line on the baseline; the next player starts when the one ahead passes the second gate.",
    "instructions": [
      "Dribble toward the first gate with the right hand.",
      "Slow down one stride before the gate (sell it).",
      "Cross the ball low to the left hand in front of the gate.",
      "Burst through the gate with the left hand and head to the next gate.",
      "Repeat at every gate, alternating hands, and finish with a lay-up."
    ],
    "coachingPoints": [
      "Cross the ball below the knees, not across the waist.",
      "Plant the outside foot hard to change direction.",
      "Speed up after the cross, not before it."
    ],
    "commonMistakes": [
      "Wide, high crossovers a defender could poke away.",
      "Making the move at the gate instead of before it.",
      "Same speed through the whole course."
    ],
    "safety": "Use flat cones or discs so no one trips; keep the next player waiting until the gap is safe.",
    "progressions": [
      "Replace each crossover with a between-the-legs or behind-the-back change.",
      "Add a passive defender at the last gate."
    ],
    "regressions": ["Walk the course first, then jog.", "Widen the gates."],
    "variations": [
      "Two-move gates: cross then in-and-out.",
      "Time each run and chase a personal best."
    ],
    "successCriteria": [
      "All five crossovers made below the knees without touching a cone.",
      "Clear burst of speed after each gate."
    ],
    "gameApplication": "The crossover-and-burst is the most common way to beat a defender who is overplaying one hand.",
    "repetitions": "4 to 6 runs per player",
