  "content": {
    "objective": "Exploit a switch by sealing the smaller defender and feeding the post before help arrives.",
    "setup": "3v3; the offense runs a ball screen and the defense must switch it.",
    "organization": "Rotate every four possessions.",
    "instructions": [
      "Run a ball screen at the top; the defense switches.",
      "The big calls 'Mismatch!' and seals the small defender on the block.",
      "The ball handler moves to the wing to improve the entry angle.",
      "The third player clears to the weak side to take away the helper.",
      "Enter the post and score, or kick if the double comes."
    ],
    "coachingPoints": [
      "Seal immediately after the switch.",
      "Clear the side.",
      "Pass to the target hand."
    ],
    "commonMistakes": [
      "Ignoring the mismatch and playing on.",
      "Sealing too far from the basket.",
      "Weak-side player standing in the help lane."
    ],
    "safety": "Screens are set stationary and legal; post contact uses the body, never hooking or pushing with the arms.",
    "progressions": [
      "Defense fronts the post.",
      "Defense doubles from the top."
    ],
    "regressions": [
      "Walk-through.",
      "Defense does not help."
    ],
    "variations": [
      "Guard isolates the big on the perimeter.",
      "Mismatch from an off-ball switch."
    ],
    "successCriteria": [
      "Post touch after most switches.",
      "Score or open kick-out."
    ],
    "gameApplication": "Switching defenses invite mismatches; teams that punish them force the defense to stop switching.",
