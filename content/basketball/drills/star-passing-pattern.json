  "content": {
    "objective": "Pass accurately at different angles and follow the pass to the new line, keeping the pattern flowing.",
    "setup": "Five lines at the points of a star (top, both wings, both blocks) around the half court.",
    "organization": "Two or more players per line; start with one ball.",
    "instructions": [
      "The top line passes to the left block line (skipping the nearest line).",
      "The passer follows the pass to the back of that line.",
      "The receiver passes to the right wing line, and so on round the star.",
      "Once the pattern flows, add a second ball at the opposite point.",
      "Reverse the direction every two minutes."
    ],
    "coachingPoints": [
      "Call the receiver's name before passing.",
      "Follow your pass at speed.",
      "Meet the pass with a step toward it."
    ],
    "commonMistakes": [
      "Following the wrong pass and blocking a line.",
      "Floating lob passes across the star.",
      "Receivers waiting flat-footed."
    ],
    "safety": "With two balls, passers must call loudly; nobody runs across a pass in flight.",
    "progressions": ["Two balls.", "Add a jump stop and pivot before each pass."],
    "regressions": ["Pass to the nearest line only.", "Walking pace."],
    "variations": ["Bounce passes only.", "Receiver must shot-fake before passing."],
    "successCriteria": [
      "Two minutes without a dropped ball.",
      "Everyone follows the correct pass."
    ],
    "gameApplication": "Passing at angles and filling the spot you passed to are habits of good team offense.",
    "repetitions": "2 x 2 minutes each direction",
