  "content": {
    "objective": "Open the hips quickly and run to recover position when beaten, rather than sliding helplessly.",
    "setup": "Defenders in a stance at the top; coach points left or right.",
    "organization": "Lines of defenders.",
    "instructions": [
      "Start in a stance.",
      "Coach points: drop-step that way (back foot swings open).",
      "Run three steps to a cone on the diagonal.",
      "Turn back into a stance and slide two steps.",
      "Return and repeat the other way."
    ],
    "coachingPoints": [
      "Open the hips with the drop step: do not cross the feet first.",
      "Run when beaten, then slide again.",
      "Stay low on the turn."
    ],
    "commonMistakes": [
      "Sliding when the attacker is already past.",
      "Standing up on the drop step.",
      "Turning the wrong way."
    ],
    "safety": "Use a clear, dry floor and space players so nobody collides when changing direction.",
    "progressions": ["Live driver.", "React to a ball movement instead of a point."],
    "regressions": ["Walk it.", "One direction."],
    "variations": ["Drop step and run full court.", "Drop step into a closeout."],
    "successCriteria": ["Correct direction on every cue.", "Back in stance at the cone."],
    "gameApplication": "Defenders who get beaten can still recover if they run instead of sliding.",
    "repetitions": "8 reps",
