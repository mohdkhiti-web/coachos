  "content": {
    "objective": "Change direction at speed with a behind-the-back dribble without breaking stride.",
    "setup": "Two cones at each free-throw line extended, a cone in the middle at half court.",
    "organization": "One line in each corner; go when the player ahead reaches half court.",
    "instructions": [
      "Push the ball hard from the corner toward the middle cone.",
      "At the cone, wrap the ball behind the back to the other hand without slowing.",
      "Attack the far elbow cone and repeat the behind-the-back.",
      "Finish at the far rim.",
      "Return along the other sideline with the other hand."
    ],
    "coachingPoints": [
      "Wrap the ball around the hip with the wrist, not the arm.",
      "Step with the same-side foot as the ball goes behind.",
      "Keep sprinting through the change."
    ],
    "commonMistakes": [
      "Slowing almost to a stop before the move.",
      "Ball bouncing too far behind and getting lost.",
      "Swinging the whole arm."
    ],
    "safety": "Clear lanes; the next player waits until the previous one has passed half court.",
    "progressions": [
      "Add a chasing defender who starts two metres behind.",
      "Two behind-the-backs in a row at the middle cone."
    ],
    "regressions": ["Walk then jog the move.", "Stationary behind-the-back wraps first."],
    "variations": [
      "Finish with a pass to a trailer.",
      "Use the move to avoid a cone 'charge spot'."
    ],
    "successCriteria": [
      "No loss of speed through the change.",
      "Finishes with the hand away from the last cone."
    ],
    "gameApplication": "The behind-the-back is the safest change of hand at full speed because the ball never crosses in front of a defender.",
    "repetitions": "3 trips each direction",
