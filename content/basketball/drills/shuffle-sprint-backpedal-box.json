  "content": {
    "objective": "Build defensive movement fitness by linking slides, sprints and backpedals in a continuous pattern.",
    "setup": "Cones at the four corners of a half court.",
    "organization": "Players start every five seconds; three laps each, rest one minute.",
    "instructions": [
      "Slide along the baseline in a low stance.",
      "Sprint up the sideline to half court.",
      "Slide across the half-court line.",
      "Backpedal down the other sideline.",
      "Repeat for three laps."
    ],
    "coachingPoints": [
      "Stay low on slides.",
      "Change direction at the cone, not before.",
      "Backpedal with the chest over the toes."
    ],
    "commonMistakes": [
      "Crossing the feet on slides.",
      "Rounding the corners.",
      "Standing up when tired."
    ],
    "safety": "Build volume gradually, allow water breaks, and stop any player who shows dizziness or pain; work-to-rest ratios suit the group's age.",
