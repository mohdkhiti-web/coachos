  "content": {
    "objective": "Link two and three dribble moves together in rhythm, keeping the ball low and protected between moves.",
    "setup": "Three cones in a line from the top of the key to the free-throw line, two metres apart.",
    "organization": "One line at half court; the next player starts at the second cone.",
    "instructions": [
      "Level 1: crossover at each cone, finish with a lay-up.",
      "Level 2: crossover plus between-the-legs at each cone.",
      "Level 3: crossover, between-the-legs and behind-the-back at each cone.",
      "Move up a level only after two clean runs at the current one.",
      "Finish every run at the rim at game speed."
    ],
    "coachingPoints": [
      "Rhythm first: each move takes one dribble.",
      "Ball below the knee during every change.",
      "The last move points the body at the rim."
    ],
    "commonMistakes": [
      "Extra dribbles between moves.",
      "Rising up out of the stance on the behind-the-back.",
      "Looking at the cone instead of the rim."
    ],
    "safety": "Run cones in a straight line with room either side; the finisher clears the lane before the next starts.",
    "progressions": [
      "Add a passive defender at the last cone.",
      "Pull up for a jump shot instead of finishing."
    ],
    "regressions": ["Stationary combinations before moving.", "Level 1 only for younger players."],
    "variations": ["Reverse combinations (behind-the-back first).", "Two-ball version of level 1."],
    "successCriteria": [
      "Two clean runs at a level before moving up.",
      "No extra dribbles between moves."
