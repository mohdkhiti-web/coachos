  "content": {
    "objective": "Run a screening continuity that produces lay-ups and elbow shots and teaches screening angles.",
    "setup": "Five players in the flex set: two at the elbows extended, two on the blocks, one in the corner.",
    "organization": "Walk, jog, then live 5v5.",
    "instructions": [
      "The ball is reversed to the weak-side elbow.",
      "The block player sets a flex screen for the corner player, who cuts across the lane.",
      "The passer at the top down-screens for the flex screener.",
      "The screener pops to the top for the next reversal.",
      "Repeat on the other side."
    ],
    "coachingPoints": [
      "Flex cut shoulder to shoulder off the screen.",
      "Down screen right after the flex cut.",
      "Reversal pass first."
    ],
    "commonMistakes": [
      "Cutting before the screen arrives.",
      "Down screen on the wrong player.",
      "Pattern without reading the defense."
    ],
    "safety": "Screens are set stationary and legal; defenders are allowed to see the screen in walk-throughs before live play.",
    "progressions": [
      "Live 5v5 with options (curl, fade).",
      "Add a back-door counter."
    ],
    "regressions": [
      "Walk-through with cones.",
      "3v0 on one side."
    ],
    "variations": [
      "Flex against a switching defense.",
      "Flex with a post option."
    ],
    "successCriteria": [
      "Pattern flows three reversals.",
      "Lay-up from the flex cut."
    ],
    "gameApplication": "Continuity offenses give young teams structure and teach screening habits.",
    "repetitions": "3 x 3 minutes",
