  "content": {
    "objective": "Catch in the short roll against a trap and make a quick finish or pass in the four-on-three behind.",
    "setup": "Ball handler and screener at the top; two defenders trap the ball handler; one weak-side defender.",
    "organization": "Rotate roles.",
    "instructions": [
      "The screener sets a ball screen; both defenders trap the ball handler.",
      "The screener rolls short toward the free-throw line.",
      "The ball handler passes out of the trap to the short roll.",
      "The roller catches, faces the rim and reads the weak-side defender.",
      "Finish if the defender stays; pass to the weak side if they step up."
    ],
    "coachingPoints": [
      "Short roll: into the open space, not all the way to the rim.",
      "Catch and face immediately.",
      "Read the low defender."
    ],
    "commonMistakes": [
      "Rolling deep into the help.",
      "Catching with the back to the rim.",
      "Forcing the finish into the help."
    ],
    "safety": "Trappers play the ball; no hacking the passer's arms.",
    "progressions": ["Add a second weak-side defender.", "Two-second decision limit."],
    "regressions": ["Coach passes to the short roll.", "Defender stays fixed."],
    "variations": ["Short roll to a floater.", "Short roll to a lob."],
    "successCriteria": [
      "Correct decision after the catch on most reps.",
      "Pass out of the trap completed."
    ],
    "gameApplication": "Teams that blitz the ball screen leave a four-on-three behind; the short roll exploits it.",
