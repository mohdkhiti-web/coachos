  "content": {
    "objective": "Adjust the take-off and backboard target to the angle of approach.",
    "setup": "Three cones: baseline (corner), wing and top of the key; a line at each.",
    "organization": "Lines rotate clockwise after each lay-up.",
    "instructions": [
      "Baseline line: dribble along the baseline and finish high on the near side of the square.",
      "Wing line: finish on the top corner of the square.",
      "Middle line: finish soft over the front of the rim or off the middle of the square.",
      "Rebound your own ball and join the next line.",
      "Switch to the other side of the court for the other hand."
    ],
    "coachingPoints": [
      "Steeper angle, higher on the board.",
      "Correct foot for the hand.",
      "Eyes on the target spot."
    ],
    "commonMistakes": [
      "Same aim point from every angle.",
      "Running under the rim from the baseline.",
      "Wrong foot on the middle approach."
    ],
    "safety": "Finishers land on two feet and clear the lane; the next player waits until the landing area is empty.",
    "progressions": ["Full speed.", "Weak-hand side round."],
    "regressions": ["Two angles only.", "Walk then jog."],
    "variations": ["Finish with a reverse from the baseline.", "Add a defender trailing."],
    "successCriteria": ["Makes from all three angles.", "Correct foot every time."],
    "gameApplication": "Drives arrive from different angles; each needs its own finish.",
