  "content": {
    "objective": "Recover from a skip pass with an X-out switch rather than a long, late closeout.",
    "setup": "Offense in a 4-out spread with the ball at the right wing; defense in help positions; one helper sunk deep.",
    "organization": "Rotate offense and defense every four possessions.",
    "instructions": [
      "Ball at the right wing; the weak-side defenders sink to help.",
      "The offense skips to the left wing.",
      "The defender nearest the wing (from the low help spot) closes out to the wing.",
      "The higher help defender drops to the corner player: the X.",
      "Both call 'Switch!'; play live."
    ],
    "coachingPoints": [
      "Closest defender takes the ball.",
      "Call the switch loudly.",
      "Sprint on the skip, not after the catch."
    ],
    "commonMistakes": [
      "Both chasing the ball.",
      "Silent swaps that leave a player open.",
      "Late reaction to the skip."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
