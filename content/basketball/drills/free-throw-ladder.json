    "objective": "Build free-throw consistency through streaks while keeping a calm routine.",
    "setup": "Two or three players per basket; each keeps their own rung count.",
    "organization": "Players take turns at the line.",
    "instructions": [
      "Rung 1: make one free throw.",
      "Rung 2: make two in a row; rung 3: three in a row, and so on.",
      "A miss drops you down one rung.",
      "Take turns: one attempt at your current rung, then the next player.",
      "First to rung 5 wins."
    ],
    "coachingPoints": [
      "Routine before every shot.",
      "Short memory: a miss is just the next shot.",
      "Legs bent, arc high."
    ],
