  "content": {
    "objective": "Beat two consecutive defenders in confined zones without picking up the dribble, as when bringing the ball up against pressure.",
    "setup": "Two zones marked with cones in the backcourt: zone 1 from the baseline to the free-throw line extended, zone 2 to half court. One defender in each zone.",
    "organization": "Dribbler goes until beaten or through; rotate dribbler to zone 1 defender to zone 2 defender.",
    "instructions": [
      "The dribbler starts on the baseline; the zone 1 defender pressures immediately.",
      "Get through zone 1 using crossovers, retreat dribbles or spins.",
      "The zone 2 defender picks up the dribbler at the free-throw line extended.",
      "Beat zone 2 to the half-court line to score a point.",
      "Defenders stay in their zone; a steal or a pick-up ends the turn."
    ],
    "coachingPoints": [
      "Attack a defender's front foot to turn them.",
      "Use the sideline as a second defender only if you must; the middle is better.",
      "Change pace into each zone."
    ],
    "commonMistakes": [
      "Turning the back to the defender for too long.",
      "Picking the ball up when trapped near the sideline.",
      "Dribbling straight at the defender's chest."
    ],
    "safety": "Defenders cannot reach in from behind; contact rules as in a game.",
    "progressions": [
      "Allow defenders to leave their zone to trap.",
      "Add a time limit (8 seconds)."
    ],
    "regressions": ["One defender only.", "Defenders play with hands behind their backs."],
    "variations": ["Narrow the zones with cones.", "Play the full court with three zones."],
    "successCriteria": [
      "Reaches half court on at least half of the attempts.",
      "Never picks up the dribble in a zone."
    ],
    "gameApplication": "This is the situation guards face against full-court pressure: beat one defender, then the next.",
    "repetitions": "4 to 6 turns per player",
