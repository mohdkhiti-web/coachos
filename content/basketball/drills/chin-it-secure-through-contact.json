  "content": {
    "objective": "Hold onto rebounds when bumped by protecting the ball under the chin with the elbows out.",
    "setup": "Rebounder near the block; a partner with a contact pad or arm; coach tosses off the board.",
    "organization": "Five rebounds each, then rotate.",
    "instructions": [
      "The coach tosses the ball off the backboard.",
      "Jump and catch with two hands.",
      "Land wide and bring the ball to the chin, elbows out.",
      "The partner bumps with the pad and swipes at the ball for two seconds.",
      "Pivot away and outlet."
    ],
    "coachingPoints": [
      "Ball to the chin immediately.",
      "Elbows out, not swinging.",
      "Wide, strong landing."
    ],
    "commonMistakes": [
      "Bringing the ball down to the waist.",
      "Swinging elbows at the partner.",
      "Narrow landing that gets knocked over."
    ],
    "safety": "Elbows protect the ball but are never swung; the partner bumps the body, not the head.",
    "progressions": [
      "Two swipers.",
      "Catch in traffic after a box-out."
    ],
    "regressions": [
      "No bump, swipes only.",
      "Catch a chest pass instead of a rebound."
    ],
    "variations": [
      "Chin then power-up shot.",
      "Chin then pivot to outlet."
    ],
    "successCriteria": [
      "Keeps the ball on most reps.",
      "No elbow fouls."
    ],
    "gameApplication": "Many rebounds are lost after the catch; chinning the ball keeps them.",
    "repetitions": "5 rebounds x 3",
