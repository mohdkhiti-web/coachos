  "content": {
    "objective": "Build top-end conditioning through repeated sprints to progressively farther lines and back.",
    "setup": "Players line up on the baseline with clear sprint lanes down the court.",
    "organization": "",
    "instructions": [
      "Sprint to the near free-throw line and back to the baseline.",
      "Sprint to half court and back to the baseline.",
      "Sprint to the far free-throw line and back to the baseline.",
      "Sprint the full length of the court and back to finish."
    ],
    "coachingPoints": [
      "Touch each line with a hand or foot, not just approximately.",
      "Push through the whole set rather than slowing in the middle.",
      "Use quick, controlled turns at each line rather than a lazy curve."
    ],
    "commonMistakes": [
      "Rounding the turn instead of touching the actual line.",
      "Pacing too conservatively on the shorter early sprints.",
      "Letting technique break down once fatigue sets in."
    ],
    "safety": "Make sure the full length of the court is clear and the floor is dry.",
