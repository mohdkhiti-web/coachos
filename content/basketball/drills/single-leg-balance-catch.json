    "objective": "Improve single-leg balance and core control under the distraction of a catch.",
    "setup": "Partners three metres apart, one ball.",
    "organization": "Pairs; 30 seconds per leg.",
    "instructions": [
      "Stand on the right leg, knee slightly bent.",
      "The partner passes high, low and to each side.",
      "Catch and return the pass without putting the other foot down.",
      "Switch legs after 30 seconds.",
      "Switch roles."
    ],
    "coachingPoints": ["Soft standing knee.", "Hips level.", "Brace the trunk on the catch."],
    "commonMistakes": [
      "Locked straight knee.",
      "Hip dropping to one side.",
      "Touching the floor with the free foot."
    ],
    "safety": "Gentle passes; players stand away from walls and equipment.",
    "progressions": ["Eyes closed between catches.", "Stand on a folded mat."],
    "regressions": ["Lightly touch the free toe down.", "Chest passes only."],
    "variations": ["Single-leg chest passes back.", "Partner gives a gentle push on the ball."],
    "successCriteria": ["30 seconds per leg without touching down.", "Level hips throughout."],
