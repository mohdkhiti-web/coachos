  "content": {
    "objective": "Run hard to a three-point spot in transition, arrive square and shoot off the catch.",
    "setup": "Ball handler at the far baseline; shooters start on the far wings.",
    "organization": "Shooter rebounds and goes to the passer line.",
    "instructions": [
      "The ball handler pushes the ball up the middle.",
      "The shooter sprints the outside lane to the right corner.",
      "Arrive with the last two steps slowed down and the feet behind the line.",
      "The ball handler passes ahead; catch and shoot.",
      "Alternate sides: corner and wing."
    ],
    "coachingPoints": [
      "Sprint, then gather: the last two steps set the feet.",
      "Run wide, then turn to face the ball.",
      "Shoot in rhythm off the catch."
    ],
    "commonMistakes": [
      "Arriving still moving and drifting on the shot.",
      "Feet on the line (two-pointer).",
      "Slowing down the whole run."
    ],
    "safety": "Shooters run wide lanes and do not cut across the ball handler's path.",
    "progressions": ["Add a defender sprinting back to contest.", "Trail three from the top."],
    "regressions": ["Jog the lane.", "Shoot from mid-range."],
    "variations": ["Drive the closeout if a defender arrives.", "Kick-ahead pass after a rebound."],
