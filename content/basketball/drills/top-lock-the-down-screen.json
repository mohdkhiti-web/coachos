  "content": {
    "objective": "Deny a shooter the curl or pop off a down screen by top-locking and forcing a back cut into help.",
    "setup": "Passer at the wing; shooter at the block; screener at the elbow; two defenders.",
    "organization": "Rotate roles.",
    "instructions": [
      "The screener sets a down screen.",
      "The shooter's defender positions above the shooter (top-lock), chest to the shooter's side.",
      "Force the shooter to cut back door, away from the screen.",
      "The screener's defender stays in the lane ready to help on the back cut.",
      "Play live."
    ],
    "coachingPoints": [
      "Get above before the screen arrives.",
      "Force the cut to the baseline, where help is.",
      "Screener's defender talks: 'I'm here!'"
    ],
    "commonMistakes": [
      "Trailing and giving the curl.",
      "Top-locking without help behind.",
      "Screener's defender leaving the lane."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Add the passer's defender.",
      "Shooter reads and back cuts."
    ],
    "regressions": [
      "Walk-through.",
      "Shooter jogs."
    ],
    "variations": [
      "Switch the down screen instead.",
      "Top-lock on a flare screen."
    ],
    "successCriteria": [
      "Shooter does not catch above the elbow.",
      "Back cut covered by help."
    ],
    "gameApplication": "Top-locking takes away the shooter's best option off a down screen.",
    "repetitions": "8 reps",
