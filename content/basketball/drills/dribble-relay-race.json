  "content": {
    "objective": "Dribble at speed around a turning point without losing control, under the pressure of a team race.",
    "setup": "Teams of three to six in lines on the baseline; one cone per team at the free-throw line extended.",
    "organization": "First player in each line holds the team's ball.",
    "instructions": [
      "On the whistle, the first player dribbles to the cone with the called hand.",
      "Dribble around the cone, changing hands on the turn.",
      "Dribble back and hand the ball to the next player (no throwing).",
      "The next player cannot leave the baseline before receiving the ball.",
      "First team with everyone home and seated wins."
    ],
    "coachingPoints": [
      "Turn tight around the cone with the ball on the outside hand.",
      "Hand-off, not a throw: stop and give it safely.",
      "Speed is good, control is better: a lost ball costs more."
    ],
    "commonMistakes": [
      "Running ahead of the ball and losing it at the turn.",
      "Throwing the ball to the next player.",
      "Leaving early."
    ],
    "safety": "Lines at least three metres apart; teammates wait behind the baseline, not on the court.",
    "progressions": ["Add a crossover at the halfway point.", "Two cones to zig-zag around."],
    "regressions": ["Walk the race.", "Allow any hand."],
    "variations": [
      "Weak-hand only round.",
      "Players must make a shot before the next teammate goes."
    ],
    "successCriteria": [
      "Team finishes without a lost ball.",
      "Every hand-off is a safe hand-to-hand exchange."
    ],
    "gameApplication": "Competition makes players handle the ball at the speed of a game rather than the speed of a drill.",
    "repetitions": "4 to 5 races",
