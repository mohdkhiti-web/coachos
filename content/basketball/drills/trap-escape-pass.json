  "content": {
    "objective": "Stay calm in a trap: pivot away, keep the ball high or low and pass to the open middle or sideline outlet.",
    "setup": "Ball handler near the right sideline at half court; two trappers; outlets at the middle and the sideline.",
    "organization": "Rotate ball handler, trappers, outlets.",
    "instructions": [
      "The ball handler dribbles toward the sideline; two defenders trap.",
      "Pick up the dribble only if needed; pivot away from the trap and keep the ball moving (high-low).",
      "Outlets move: the middle player flashes toward the ball, the sideline player comes back.",
      "Pass over or around the trap to the open outlet: overhead or bounce.",
      "The outlet attacks the open floor."
    ],
    "coachingPoints": [
      "Do not turn your back fully: see the floor.",
      "Pass fake to move the trappers' hands.",
      "Outlets come to the ball; do not wait."
    ],
    "commonMistakes": [
      "Picking up the dribble too early.",
      "Lob passes across the court (interception).",
      "Outlets standing still behind defenders."
    ],
    "safety": "Trappers play the ball, no hacking the arms; stop play on any dangerous swipe.",
    "progressions": [
      "Add a fourth defender who rotates to the middle.",
      "Five-second count on the trapped player."
    ],
    "regressions": ["Trappers arrive one at a time.", "Outlets stand in fixed spots."],
    "variations": [
      "Trap in the corner instead of the sideline.",
      "Split the trap with a dribble when it is not closed."
    ],
    "successCriteria": [
      "Escapes the trap without a turnover on most reps.",
      "Passes within four seconds of the trap."
    ],
    "gameApplication": "Presses rely on traps; teams that pass out of them calmly turn pressure into lay-ups.",
    "repetitions": "6 reps per ball handler",
