  "content": {
    "objective": "Keep your body on the line between the offensive player and the basket.",
    "setup": "Pairs at different spots around the arc; the offensive player has a ball.",
    "organization": "Switch after 30 seconds.",
    "instructions": [
      "The coach points to the basket and draws an imaginary line from the offensive player to it.",
      "The offensive player walks with the ball (no dribble) to different spots.",
      "The defender moves to stay on the line, about one arm-length away.",
      "On the whistle, everyone freezes; the coach checks the lines.",
      "Progress to a slow dribble."
    ],
    "coachingPoints": [
      "Your back points to the basket.",
      "One arm-length away.",
      "Move your feet, not your arms."
    ],
    "commonMistakes": [
      "Standing beside the player.",
      "Getting too close and being beaten.",
      "Turning to watch the ball."
    ],
    "safety": "Walking pace only for younger players.",
    "progressions": ["Slow dribble.", "Offense tries to get past to the basket."],
    "regressions": ["Coach places a cone on the line.", "Static positions first."],
    "variations": [
      "Use a hoop on the floor as the basket.",
      "Partner calls 'freeze' instead of the coach."
    ],
    "successCriteria": ["On the line at every freeze.", "Correct distance."],
    "gameApplication": "Every team defense is built on players staying between their player and the basket.",
    "repetitions": "4 rounds",
