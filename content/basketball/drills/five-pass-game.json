  "content": {
    "objective": "Move without the ball to get open and pass quickly and accurately under defensive pressure.",
    "setup": "Half court, two teams of three or four with bibs.",
    "organization": "Play for 3-minute games; losing team stays on.",
    "instructions": [
      "The offense may not dribble: the ball moves only by passing.",
      "Count each completed pass out loud; five in a row scores a point.",
      "No pass back to the player who just passed to you.",
      "A deflection, steal or ball out of bounds resets the count and turns the ball over.",
      "After a point, the ball goes to the other team at the top of the key."
    ],
    "coachingPoints": [
      "Cut to open space and show a target.",
      "Use pivots and fakes before passing.",
      "Pass to where the receiver is moving."
    ],
    "commonMistakes": [
      "Everyone standing still around the ball.",
      "Lob passes over defenders that are easy to intercept.",
      "Bunching up in one area."
    ],
    "safety": "No contact on the passer; defenders cannot wrestle for held balls (held ball = turnover to defense).",
    "progressions": [
      "Require bounce passes for passes three and four.",
      "Score only if the fifth pass leads to a lay-up."
    ],
    "regressions": ["Three passes for a point.", "Offense outnumbers defense 4v3."],
    "variations": ["Allow one dribble per player.", "Play in a smaller area to increase pressure."],
    "successCriteria": [
      "Team scores at least one point per minute.",
      "Every player touches the ball in each scoring sequence."
    ],
    "gameApplication": "Players learn that moving without the ball and passing early beats pressure better than dribbling.",
    "repetitions": "3 games of 3 minutes",
