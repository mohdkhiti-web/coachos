  "content": {
    "objective": "Stop on two feet at once, square to the rim, and shoot in balance without drifting.",
    "setup": "Three cones in the lane area (left of the lane, middle, right) about three metres from the rim.",
    "organization": "One line at the top; rotate after each shot.",
    "instructions": [
      "Dribble from the top toward a cone.",
      "Jump-stop at the cone with both feet landing together, knees bent.",
      "Square the shoulders and hips to the rim.",
      "Shoot and hold the follow-through.",
      "Rebound, pass to the next player and go to the back of the line."
    ],
    "coachingPoints": [
      "Land with feet shoulder-width apart.",
      "Ball goes straight up into the shooting pocket.",
      "Go straight up and land on the same spot."
    ],
    "commonMistakes": [
      "Landing one foot after the other and travelling.",
      "Leaning forward after the stop.",
      "Shooting before the shoulders are square."
    ],
    "safety": "Shooters rebound their own ball only when the lane is clear; nobody stands under the rim while others shoot.",
    "progressions": ["Jump stop at full speed.", "Defender trails the dribbler."],
    "regressions": ["Walk in and stop.", "Catch a pass and jump-stop instead of dribbling."],
    "variations": ["Jump-stop and bank shot.", "Jump-stop, pivot, shoot."],
    "successCriteria": ["No travel on any stop.", "Lands within a foot of the take-off spot."],
    "gameApplication": "A balanced jump stop gives young players a legal, controlled finish to any drive.",
    "repetitions": "3 shots at each cone",
