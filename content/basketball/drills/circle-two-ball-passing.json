  "content": {
    "objective": "Make quick, accurate catches and passes with no hesitation, as a group, under the time pressure of a second ball.",
    "setup": "Six to ten players in a circle about six metres across.",
    "organization": "Whole group in one circle; two balls start on opposite sides.",
    "instructions": [
      "Both balls start on opposite sides of the circle.",
      "Pass to the player on your right with a chest pass.",
      "Each ball goes round as fast as possible; one ball chases the other.",
      "If a ball catches the other, the chasing side wins the round.",
      "Change direction and pass type every round."
    ],
    "coachingPoints": [
      "Hands ready before the ball arrives.",
      "Pass on the step, not after a pause.",
      "Call the name of the player you pass to."
    ],
    "commonMistakes": [
      "Watching the other ball and missing your own catch.",
      "Rushing into fumbles.",
      "Throwing across the circle by mistake."
    ],
    "safety": "Use chest and bounce passes only; no throwing across the circle.",
    "progressions": ["Add a third ball.", "Skip a player with each pass."],
    "regressions": ["One ball, slower pace.", "Smaller circle."],
    "variations": ["Overhead passes only.", "Players must jump-stop on each catch."],
    "successCriteria": ["Three laps without a dropped pass.", "Every pass called by name."],
    "gameApplication": "Quick, clean ball movement in the half court comes from catching ready and passing on the beat.",
    "repetitions": "4 rounds",
