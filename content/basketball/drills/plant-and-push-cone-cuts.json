  "content": {
    "objective": "Decelerate quickly and push off the outside foot to change direction sharply.",
    "setup": "Five cones in a zig-zag four metres apart.",
    "organization": "One at a time; next goes at the second cone.",
    "instructions": [
      "Sprint to the first cone.",
      "Lower the hips and plant the outside foot beside the cone.",
      "Push hard off that foot toward the next cone.",
      "Repeat through all cones.",
      "Jog back and repeat."
    ],
    "coachingPoints": [
      "Lower before the plant, not at it.",
      "Outside foot plants, inside knee drives.",
      "Eyes on the next cone."
    ],
    "commonMistakes": [
      "Rounding the cut.",
      "Planting with the inside foot.",
      "Upright body on the change."
    ],
    "safety": "Use a clear, dry floor and space players so nobody collides when changing direction.",
    "progressions": ["React to a coach's point.", "Add a ball (dribble)."],
    "regressions": ["Jog.", "Wider cone angles."],
    "variations": ["Backpedal one leg of the course.", "Slide one leg."],
    "successCriteria": [
      "Sharp angles at every cone.",
      "No slowing between cones beyond the plant."
    ],
    "gameApplication": "Getting open and staying in front both depend on sharp changes of direction.",
