  "content": {
    "objective": "Protect the ball through the gather and finish when defenders reach for it.",
    "setup": "Two swipers stand at the elbow and the block; a line at the wing.",
    "organization": "Rotate swipers and finishers.",
    "instructions": [
      "Drive from the wing between the two swipers.",
      "The swipers reach for the ball as it passes.",
      "Gather the ball high and tight to the chest on the side away from them.",
      "Finish off the board.",
      "Repeat from the other side."
    ],
    "coachingPoints": [
      "Rip the ball high on the gather.",
      "Shoulder between swiper and ball.",
      "Finish strong, do not shy away."
    ],
    "commonMistakes": [
      "Gathering low at the waist.",
      "Holding the ball out in front.",
      "Pulling away from the rim."
    ],
    "safety": "Swipers touch the ball only; no hitting arms or face.",
    "progressions": ["Swipers move.", "Three swipers."],
    "regressions": ["One swiper.", "Swipers hold pads instead of reaching."],
    "variations": ["Power finish off two feet.", "Euro around the second swiper."],
    "successCriteria": ["Ball protected on most reps.", "Finish made despite the swipe."],
    "gameApplication": "In traffic, finishers lose the ball on the gather; keeping it high and tight saves possessions.",
