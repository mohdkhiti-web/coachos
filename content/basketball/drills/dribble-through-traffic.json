  "content": {
    "objective": "Keep the ball protected and the head up while moving through a crowded space with constant changes of direction.",
    "setup": "All players inside the three-point line (or the half court for big groups) with a ball each.",
    "organization": "Whole group moves at once on the coach's commands.",
    "instructions": [
      "Everyone dribbles around the area, avoiding contact with any player.",
      "On 'switch', change hands; on 'freeze', jump-stop and pivot.",
      "On 'shrink', the coach reduces the space with cones and players must stay in it.",
      "On 'go', speed up for five seconds, then return to a jog.",
      "Finish with one minute of weak-hand only."
    ],
    "coachingPoints": [
      "Look for the open space, not at the ball.",
      "Ball on the side away from the nearest player.",
      "Change direction with a crossover, not a swerve."
    ],
    "commonMistakes": [
      "Watching the ball and bumping into others.",
      "Dribbling in a straight line around the edge.",
      "High, loose dribbles in a crowd."
    ],
    "safety": "Jog pace only; stop the drill if players start running at full speed in the crowded space.",
    "progressions": [
      "Some players without a ball try to touch loose dribbles.",
      "Shrink the area further."
    ],
    "regressions": ["Bigger area and walking pace.", "Fewer players at once."],
    "variations": [
      "Play music; freeze when it stops.",
      "Every player must touch three lines while dribbling."
    ],
    "successCriteria": [
      "No collisions and no lost balls for a full minute.",
      "Head up on every change of direction."
    ],
    "gameApplication": "Real games are crowded; handling the ball while scanning for space is the base of every drive and kick.",
    "repetitions": "3 to 4 minutes continuous",
