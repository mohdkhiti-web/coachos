  "content": {
    "objective": "Use a flare screen to drift away from the ball and shoot off a skip pass, square on the catch.",
    "setup": "Ball handler at the left slot; screener at the top; shooter at the right slot.",
    "organization": "Rotate all three roles.",
    "instructions": [
      "The ball handler dribbles toward the left wing.",
      "The screener sets a flare screen facing away from the ball on the shooter's defender.",
      "The shooter fakes toward the ball, then fades to the right wing behind the screen.",
      "The ball handler throws an overhead skip pass.",
      "The shooter catches with the feet set and shoots."
    ],
    "coachingPoints": [
      "Sell the fake toward the ball before fading.",
      "Fade with the hands up and the body square to the passer.",
      "Overhead skip with arc over the help."
    ],
    "commonMistakes": [
      "Fading too early, before the screen.",
      "Fading too far out of range.",
      "Flat skip pass that gets intercepted."
    ],
    "safety": "Screen set with feet stationary; no extended hips.",
    "progressions": [
      "Defender on the shooter who fights through.",
      "Screener slips to the rim if the defender jumps the flare."
    ],
    "regressions": ["Pass from closer, chest pass.", "No defender."],
    "variations": ["Flare screen in the corner.", "Shooter drives the closeout instead."],
    "successCriteria": [
      "Catch arrives with the feet set.",
      "Correct timing between fade and pass."
    ],
    "gameApplication": "Flare screens free shooters away from the ball where help defenders cannot reach.",
