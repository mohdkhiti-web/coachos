  "content": {
    "objective": "Score from every range at game speed for two minutes, maintaining form as fatigue builds.",
    "setup": "Shooter in the right corner; a rebounder-passer with a second ball.",
    "organization": "One shooter at a time; rebounder becomes the next shooter.",
    "instructions": [
      "Catch and shoot a corner three (3 points).",
      "Sprint to the wing, catch, one-dribble pull-up (2 points).",
      "Catch at the top and drive for a lay-up (1 point).",
      "Repeat on the other side and keep cycling for two minutes.",
      "Record the total; repeat next week."
    ],
    "coachingPoints": [
      "Sprint between shots, slow down for the shot.",
      "Every rep at full intensity.",
      "Footwork stays the same in minute two."
    ],
    "commonMistakes": [
      "Jogging to save energy and losing game speed.",
      "Off-balance threes late in the drill.",
      "Missing lay-ups by slowing down."
    ],
    "safety": "For conditioned players only; rest at least two minutes before repeating.",
    "progressions": ["Three minutes.", "Add a defender on the drive."],
    "regressions": ["One minute.", "Mid-range only."],
