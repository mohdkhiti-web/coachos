  "content": {
    "objective": "Escape a sideline trap with a reversal pass and attack the weak side.",
    "setup": "Ball handler near the sideline in the backcourt; two trappers; safety behind the ball; weak-side receiver.",
    "organization": "Rotate every four reps.",
    "instructions": [
      "The ball handler is trapped on the sideline.",
      "Pivot away from the trap, ball high or low.",
      "Pass back to the safety (behind the ball, middle of the floor).",
      "The safety swings to the open weak side.",
      "Attack up the weak side quickly."
    ],
    "coachingPoints": [
      "Pivot, do not dribble out.",
      "Safety always behind the ball.",
      "Swing fast, the trap is slow to recover."
    ],
    "commonMistakes": [
      "Dribbling into the corner.",
      "Safety level with or ahead of the ball.",
      "Slow reversal."
    ],
    "safety": "Trappers play the ball, not the body; no reaching across the inbounder's arms over the line.",
    "progressions": ["Interceptor in the middle.", "Count five seconds on the trap."],
    "regressions": ["Trappers passive.", "No interceptor."],
    "variations": ["Reverse to the inbounder.", "Middle flash instead of reversal."],
