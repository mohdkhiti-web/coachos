  "content": {
    "objective": "Read a defender's reaction to the jab step and choose the right counter: shoot, drive or cross-over drive.",
    "setup": "Offense catches at the wing; defender guards from the lane.",
    "organization": "Live 1v1 from the catch; swap after each possession.",
    "instructions": [
      "Catch in triple threat facing the rim.",
      "Jab a short step at the defender's front foot with the non-pivot foot.",
      "Defender retreats: rise and shoot.",
      "Defender stays: drive past on the jab side.",
      "Defender over-reacts to the jab: cross the jab foot over and drive the other way."
    ],
    "coachingPoints": [
      "Short, sharp jab: keep the weight on the pivot foot.",
      "Eyes on the defender's feet.",
      "Ball tight in the shooting pocket."
    ],
    "commonMistakes": [
      "Long jab that loses balance.",
      "Lifting the pivot foot (travel).",
      "Deciding before seeing the reaction."
    ],
    "safety": "Defenders play legally, no reaching for the held ball.",
    "progressions": ["Two jabs maximum before deciding.", "Add a help defender."],
    "regressions": ["Defender reacts on purpose.", "No live play after the decision."],
