  "content": {
    "objective": "Keep a controlled dribble while bending low and reaching with the free hand, the same body position used to protect the ball.",
    "setup": "Twenty cones scattered inside the three-point line; two teams start at the baseline corners with a ball each.",
    "organization": "Two teams; each team collects cones into its own corner.",
    "instructions": [
      "On the whistle, players dribble to any cone.",
      "Crouch low, keep dribbling, and pick the cone up with the free hand.",
      "Dribble back to the team corner and drop the cone.",
      "Only one cone per trip; a lost ball means the cone goes back.",
      "When all cones are collected, the team with more wins."
    ],
    "coachingPoints": [
      "Bend at the knees to reach the cone, not at the waist.",
      "Dribble with the hand away from the cone.",
      "Eyes up: plan the next cone while you dribble back."
    ],
    "commonMistakes": [
      "Stopping the dribble to pick up the cone.",
      "Bending the back and dribbling too high.",
      "Grabbing a cone with the dribbling hand."
    ],
    "safety": "Use soft flat cones; players may not dive for cones or push each other.",
    "progressions": ["Weak hand only.", "Cones must be carried back on the head (balance)."],
    "regressions": [
      "Allow two dribbles of rest with a two-hand catch.",
      "Fewer cones and a smaller area."
    ],
    "variations": [
      "Coloured cones worth different points.",
      "Return cones to the middle instead (reverse race)."
    ],
    "successCriteria": [
      "Every cone collected without a lost dribble.",
      "Picks cones up from a knee bend, not a waist bend."
    ],
    "gameApplication": "Low dribbling with a free arm is how young players protect the ball when a defender reaches in.",
    "repetitions": "3 games of about 90 s",
