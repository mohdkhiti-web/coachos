  "content": {
    "objective": "Decide correctly whether to release early for a fast break or stay to rebound based on the shot and teammates' positions.",
    "setup": "3v3 half court; the coach shoots from different distances; a guard decides whether to leak out.",
    "organization": "Rotate guards every four shots.",
    "instructions": [
      "The coach shoots from three-point range (long rebound likely) or close range.",
      "The defending guard reads: long shot and two bigs boxing out = leak out.",
      "Close shot or bigs beaten = stay and rebound.",
      "If leaking, sprint wide and call for the outlet.",
      "Play the break 2v1 or 3v2 if leaking."
    ],
    "coachingPoints": [
      "Read before leaving.",
      "Leak out wide, call for the ball.",
      "When in doubt, rebound."
    ],
    "commonMistakes": [
      "Leaking out on every shot.",
      "Leaving before the shot is released.",
      "Rebounders not looking for the leaker."
    ],
    "safety": "Lanes stay wide so players do not collide; runners finishing at speed have clear space behind the basket.",
    "progressions": [
