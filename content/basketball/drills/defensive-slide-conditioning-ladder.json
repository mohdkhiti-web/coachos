  "content": {
    "objective": "Combine real defensive slide technique with a genuine conditioning load.",
    "setup": "Players start at the block in a defensive stance with clear lateral space to slide.",
    "organization": "",
    "instructions": [
      "Slide from the block to the elbow and back, staying low throughout.",
      "Slide from the block to the top of the key and back.",
      "Slide the full width from block to block and back.",
      "Rest briefly and repeat the full ladder two more times."
    ],
    "coachingPoints": [
      "Stay low through every slide, even as fatigue builds.",
      "Push off the trail foot rather than crossing the feet.",
      "Keep the hands active throughout, not resting on the knees."
    ],
    "commonMistakes": [
      "Standing up tall as fatigue sets in late in the set.",
      "Crossing the feet to move faster instead of sliding properly.",
      "Skipping the recovery interval instead of using it to reset."
    ],
    "safety": "Check the floor is dry and clear before any lateral sliding.",
