    "organization": "Whole group.",
    "instructions": [
      "Stand on the right leg beside a line.",
      "Hop forward over the line and land on the right leg; hold two seconds.",
      "Hop sideways back over the line and hold.",
      "Hop diagonally and hold.",
      "Repeat on the left leg."
    ],
    "coachingPoints": [
      "Soft knee, hip back on landing.",
      "Knee over the toes, not inward.",
      "Hold the landing still."
    ],
