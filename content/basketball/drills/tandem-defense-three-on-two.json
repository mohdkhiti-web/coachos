  "content": {
    "objective": "Delay a three-on-two break with tandem positioning and rotations until help arrives.",
    "setup": "Two defenders in the lane (one at the free-throw line, one under the basket); three attackers at half court.",
    "organization": "Defenders stay for two possessions; the attackers rotate.",
    "instructions": [
      "The top defender stops the ball at the top of the key.",
      "On a pass to a wing, the low defender takes the wing.",
      "The top defender drops to the basket area.",
      "On a pass back across, the defenders rotate again.",
      "Force a contested jump shot rather than a lay-up."
    ],
    "coachingPoints": [
      "Top stops the ball, bottom takes the first pass.",
      "Talk every rotation.",
      "Make them make an extra pass."
