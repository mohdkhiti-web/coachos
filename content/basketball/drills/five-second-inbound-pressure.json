  "content": {
    "objective": "Complete inbound passes against full denial within five seconds using fakes and timed cuts.",
    "setup": "Inbounder on the baseline; two receivers; two denying defenders and one defender on the ball.",
    "organization": "Rotate every three reps.",
    "instructions": [
      "The referee (coach) hands the ball and counts aloud.",
      "Receivers screen for each other and cut.",
      "The inbounder pass-fakes to move the ball defender's hands.",
      "Inbound before 'five'.",
      "If nothing is open by 'three', the second receiver cuts long."
    ],
    "coachingPoints": [
      "Count with the referee.",
      "Fake to move the defender's hands.",
      "Second cut is the release valve."
    ],
    "commonMistakes": [
      "Panicking and throwing a lob into traffic.",
      "Receivers cutting at the same time.",
      "Inbounder stepping on the line."
    ],
    "safety": "Trappers play the ball, not the body; no reaching across the inbounder's arms over the line.",
    "progressions": ["Defense switches screens.", "Four-second count."],
    "regressions": ["No defender on the ball.", "Six-second count."],
    "variations": ["Sideline version.", "With a timeout available."],
    "successCriteria": ["Inbound completed in time.", "No turnovers."],
