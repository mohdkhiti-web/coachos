  "content": {
    "objective": "Use the arm away from the defender and a long extension to finish around a shot-blocker.",
    "setup": "A cone (or coach with a pad) in front of the rim as the shot-blocker; lines at both wings.",
    "organization": "Alternate wings.",
    "instructions": [
      "Drive baseline toward the cone.",
      "Gather with the ball on the outside hip, away from the blocker.",
      "Reach under and around the blocker with the far hand.",
      "Finish high off the board.",
      "Repeat from the other side."
    ],
    "coachingPoints": [
      "Body between the blocker and the ball.",
      "Extend fully: long arm, soft touch.",
      "Use the board."
    ],
    "commonMistakes": [
      "Finishing with the hand nearest the blocker.",
      "Releasing low and short.",
      "Charging into the blocker."
    ],
    "safety": "Coach with a pad stands still; no hitting arms.",
    "progressions": ["Live shot-blocker.", "Finish on the opposite side of the rim."],
    "regressions": ["No blocker.", "Walk the gather."],
    "variations": ["Reach finish from the middle.", "Reach finish off one foot or two."],
    "successCriteria": [
      "Finishes without the pad touching the ball on most reps.",
      "Uses the far hand every time."
    ],
    "gameApplication": "Taller defenders block finishes that come straight at them; reaching away avoids them.",
    "repetitions": "6 each side",
