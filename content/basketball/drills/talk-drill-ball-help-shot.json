  "content": {
    "objective": "Make defensive communication automatic: every defender names their job on every pass.",
    "setup": "Four offensive players around the arc, four defenders.",
    "organization": "Offense passes slowly; rotate after six stops or two minutes.",
    "instructions": [
      "Offense passes around the perimeter, holding each catch for two seconds.",
      "The on-ball defender shouts 'Ball!'.",
      "One-pass-away defenders shout 'Deny!'; two-passes-away shout 'Help!'.",
      "On any shot, everyone shouts 'Shot!' and boxes out.",
      "A silent defender costs the defense a point."
    ],
    "coachingPoints": [
      "Loud and early: talk before the catch.",
      "Name the job, then do it.",
      "Talk on every pass, not just some."
    ],
    "commonMistakes": [
      "Talking after the move.",
      "One player talking for everyone.",
      "Calling the wrong role."
    ],
    "safety": "Play legal defense: no hand-checking, no running through screens; stop play on any dangerous collision.",
    "progressions": [
      "Live drives after the third pass.",
      "Add screens to call ('Screen left!')."
    ],
    "regressions": [
      "Freeze after each pass to check calls.",
      "Two passes away only."
    ],
    "variations": [
      "Defenders may only talk, no pointing.",
      "Add 'Switch!' calls on cuts."
    ],
    "successCriteria": [
      "Every defender talks on every pass.",
      "Correct role called."
    ],
    "gameApplication": "Talking defenses rotate on time; silent defenses get beaten by simple passes.",
    "repetitions": "3 rounds",
