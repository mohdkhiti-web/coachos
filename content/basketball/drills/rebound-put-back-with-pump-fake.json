  "content": {
    "objective": "Turn offensive rebounds into scores by staying strong, faking and finishing through contact.",
    "setup": "Attacker and defender in front of the basket; coach shoots from the wing.",
    "organization": "Play to three points, then rotate.",
    "instructions": [
      "The coach misses from the wing.",
      "The attacker fights for inside position and secures the rebound.",
      "Land strong, ball chinned, shoulders square to the baseline.",
      "Pump fake firmly to raise the defender.",
      "Go up with two feet and finish off the backboard."
    ],
    "coachingPoints": [
      "Land strong; do not bring the ball down.",
      "Real pump fake: eyes and shoulders up.",
      "Two-foot power finish."
    ],
    "commonMistakes": [
      "Rushing a weak shot from awkward balance.",
      "Bringing the ball low (stripped).",
      "Pump faking without balance."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
    "progressions": [
      "Defender plays it live from the start.",
      "Two defenders."
    ],
    "regressions": [
      "Coach tosses the miss gently.",
      "Defender passive on the shot."
    ],
