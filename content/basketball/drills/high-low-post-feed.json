  "content": {
    "objective": "Score from high-low action by sealing the low defender and feeding over the top or with a bounce pass.",
    "setup": "A wing passer; a high post at the free-throw line; a low post on the block; two defenders on the bigs.",
    "organization": "Rotate positions every four reps.",
    "instructions": [
      "The wing passes to the high post.",
      "The low post seals the defender on the high side (back to the defender).",
      "The high post feeds a lob over the top or a bounce pass to the seal.",
      "The low post catches and finishes.",
      "If no feed, the high post shoots or swings."
    ],
    "coachingPoints": [
      "Seal before the catch at the high post.",
      "High post faces the rim on the catch.",
      "Pass to the side away from the defender."
    ],
