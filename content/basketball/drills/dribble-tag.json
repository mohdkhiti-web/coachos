  "content": {
    "objective": "Keep the ball under control with the head up while changing direction and speed to avoid being tagged.",
    "setup": "Mark a boundary with four cones on half of the court. Every player has a ball. Two or three taggers wear bibs and also dribble.",
    "instructions": [
      "On the whistle, all players dribble inside the boundary; taggers try to tag others below the shoulder while keeping their own dribble.",
      "A player who is tagged or loses control of the ball does five dribble pivots on the spot, then rejoins.",
      "Change the taggers every ninety seconds so everyone tries both roles.",
      "Stop the game and ask players to use only their left hand, then only the right, then only crossovers.",
      "Finish with a slow control dribble around the boundary to cool down."
    ],
    "coachingPoints": [
      "Eyes up, not on the ball: see the tagger and the open space.",
      "Change of pace and direction beat a chase.",
      "Protect the ball with the off-arm and the body.",
      "Use both hands."
    ],
    "commonMistakes": [
      "Running without the ball and losing the dribble.",
      "Watching the ball and colliding with others.",
      "Only using the strong hand."
    ],
    "safety": "Keep the boundary large enough for the group and stop the game if players collide frequently.",
    "progressions": ["Reduce the boundary size or add a second tagger without a ball."],
    "regressions": ["Taggers walk quickly rather than run, or give players a larger boundary."],
    "variations": ["Players must use the weak hand only for the whole round."]
  },
