  "content": {
    "objective": "Secure missed free throws by stepping into the lane on the release and boxing out every lane attacker and the shooter.",
    "setup": "A shooter at the line; defenders and attackers in lane spaces as in a game.",
    "organization": "Shooter shoots; rotate positions every three shots.",
    "instructions": [
      "Defenders take the low lane spots; attackers the next spaces.",
      "On the release, step into the lane with the foot nearest the baseline.",
      "Turn into the attacker and seal.",
      "The defender at the top of the key boxes out the shooter.",
      "Rebound and outlet."
    ],
    "coachingPoints": [
      "Move on the release, not the rim.",
      "Baseline foot first.",
      "Someone always takes the shooter."
    ],
    "commonMistakes": [
      "Stepping in early (lane violation).",
      "Forgetting the shooter.",
      "Turning without contact."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
