  "content": {
    "objective": "Escape an immediate trap after a defensive rebound by pivoting away and passing to a moving outlet.",
    "setup": "Rebounder under the basket; two trapping defenders at the elbows; an outlet at the wing.",
    "organization": "Four reps each, then rotate.",
    "instructions": [
      "The coach shoots.",
      "The rebounder secures the ball and chins it.",
      "Both elbow defenders close in to trap.",
      "Pivot away from the trap, ball kept high or low away from hands.",
      "Outlet to the wing, who moves to get open."
    ],
    "coachingPoints": [
      "Chin first, then look.",
      "Pivot away from pressure.",
      "Outlet moves toward the sideline to be seen."
    ],
    "commonMistakes": [
      "Dribbling into the trap.",
      "Pivoting toward the defenders.",
      "Lob passes over the trap that get stolen."
    ],
    "safety": "Contact is with the body and forearms only: no pushing in the back, no undercutting a jumping player.",
    "progressions": [
      "Third defender in the outlet lane.",
      "Outlet must be on the side the rebound landed."
    ],
    "regressions": [
      "One trapper.",
      "Trappers have no hands."
    ],
    "variations": [
      "Escape with one power dribble.",
      "Outlet to the middle."
    ],
    "successCriteria": [
      "Clean outlet on most reps.",
      "No held balls."
    ],
    "gameApplication": "Pressing teams trap the rebounder to stop a fast break before it starts.",
    "repetitions": "4 reps x 3",
