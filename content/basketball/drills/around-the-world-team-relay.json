  "content": {
    "objective": "Build shooting pressure and team spirit through a timed relay competition.",
    "setup": "Teams of three or four line up at the first of five marked shooting spots.",
    "organization": "",
    "instructions": [
      "The first player on each team shoots from spot one until they make it, then sprints to spot two.",
      "Continue through all five spots, then tag the next teammate to start the sequence.",
      "The team finishes once every player has completed all five spots.",
      "Compare total team time against the other teams."
    ],
    "coachingPoints": [
      "Keep proper shooting form even under the pressure of racing the clock.",
      "Communicate encouragement to teammates currently shooting.",
      "Rebound your own miss quickly to keep the pace moving."
    ],
    "commonMistakes": [
      "Rushing shots so much that form completely breaks down.",
      "Standing around admiring makes instead of sprinting to the next spot.",
      "Rushing decisions just because the format feels competitive."
    ],
    "safety": "Keep enough separation between teams' shooting lines to avoid collisions.",
