  "content": {
    "objective": "Fill the five transition lanes by role so the team attacks the same way after every rebound.",
    "setup": "Five players around the defensive basket; coach shoots and the team rebounds.",
    "organization": "Run down, finish, run back; rotate positions every two trips.",
    "instructions": [
      "The coach shoots; 4 or 5 rebounds.",
      "1 calls for the outlet at the free-throw line extended.",
      "2 and 3 sprint wide to the corners.",
      "5 sprints rim to rim; 4 trails behind the ball.",
      "Finish with a lay-up, corner shot or trailer shot as the coach calls."
    ],
    "coachingPoints": [
      "Run wide: touch the sideline.",
      "Rim runner sprints first.",
      "Trailer stays behind the ball."
    ],
    "commonMistakes": [
      "Wings running in the middle.",
      "Point guard running away from the outlet.",
      "Bunching at half court."
    ],
    "safety": "Lanes stay wide so players do not collide; runners finishing at speed have clear space behind the basket.",
    "progressions": [
      "Add two defenders (5v2).",
      "Coach calls the finish late."
    ],
    "regressions": [
      "Walk the lanes with cones.",
      "Three lanes only."
    ],
    "variations": [
      "Finish into a drag screen.",
      "Rebounder pushes instead of outletting."
    ],
    "successCriteria": [
      "All five lanes filled each trip.",
      "Shot within seven seconds."
    ],
    "gameApplication": "Shared lane rules make transition fast without having to call plays.",
