  "content": {
    "objective": "Play a controlled small-sided game where the ball moves quickly, players spread out and every player gets touches.",
    "setup": "Two teams of four on half a court, one team in bibs. Extra players wait on the sideline and rotate in after each score.",
    "organization": "The team that scores stays on offence; the defence is replaced by the next team from the sideline.",
    "instructions": [
      "Offence must complete at least three passes before the first shot.",
      "A player who passes may cut to the basket or move to an open space; standing still after a pass is not allowed.",
      "A basket scores two points; a basket after five or more passes scores three.",
      "The defence plays man-to-man and does not press until the ball crosses the free-throw line.",
      "Play games to eleven points, then rotate teams."
    ],
    "coachingPoints": [
      "Pass and move: never stand still after a pass.",
      "Spread out so the defence has to cover the whole half court.",
      "Look to make the extra pass to a teammate with a better shot.",
      "Defence: stay between your player and the basket and talk."
    ],
    "commonMistakes": [
      "Holding the ball while the offence stands still.",
      "Bunching in the middle of the court.",
      "Forcing a shot before the pass count is met."
    ],
    "safety": "Play under control and stop the game if players bump into the sideline group.",
    "progressions": ["Remove the pass rule but keep a bonus point for assists."],
    "regressions": ["Play 3-on-3 with a two-pass rule."],
    "variations": ["Require a cut through the key after every pass."]
  },
