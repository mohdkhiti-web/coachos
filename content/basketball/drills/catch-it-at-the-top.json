  "content": {
    "objective": "Teach young players to time their jump and catch the ball with two hands at the top of the jump.",
    "setup": "Pairs at each basket; one player tosses, the other rebounds. Low rims if available.",
    "organization": "Five catches each, then swap; move to a new basket each round.",
    "instructions": [
      "Stand a big step from the backboard, knees bent, hands up at shoulder height.",
      "The partner tosses the ball gently against the backboard.",
      "Watch the ball, jump and catch it with two hands above the head.",
      "Land on two feet and pull the ball to the chin, elbows out.",
      "Shout 'Mine!' on every catch."
    ],
    "coachingPoints": [
      "Hands up before the ball comes.",
      "Two hands, fingers spread.",
      "Land on two feet, ball to the chin."
    ],
    "commonMistakes": [
      "Waiting with hands down.",
      "Catching against the chest.",
      "Landing on one foot."
    ],
    "safety": "Spread the pairs out so nobody lands on another player; use soft balls for the youngest groups.",
    "progressions": [
      "Self-toss off the board.",
      "A partner gently bumps on the landing."
    ],
    "regressions": [
      "Catch a bounce first, then a toss.",
      "Use a lighter or smaller ball."
    ],
    "variations": [
      "Count catches in 30 seconds.",
      "Catch and pass back to a moving partner."
    ],
    "successCriteria": [
      "Catches 4 of 5 with two hands.",
      "Lands balanced every time."
    ],
    "gameApplication": "Rebounds go to whoever catches the ball highest and holds on to it.",
    "repetitions": "5 catches x 3 rounds",
