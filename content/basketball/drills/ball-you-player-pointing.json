  "content": {
    "objective": "Position off the ball so both the ball and your player stay in view.",
    "setup": "Four offensive players around the arc pass slowly; four defenders.",
    "organization": "Rotate offense and defense.",
    "instructions": [
      "Offense passes the ball slowly around the arc.",
      "Each defender points one hand at the ball and one at their player.",
      "Defenders adjust position on every pass (closer to the ball side, further on help side).",
      "Coach freezes play and checks each defender's position.",
      "Speed up the passing."
    ],
    "coachingPoints": [
      "Form a flat triangle: ball, you, your player.",
      "Move on the pass, not after the catch.",
      "Talk: 'ball' or 'help'."
    ],
    "commonMistakes": [
      "Watching only your player.",
      "Turning the back to the ball.",
      "Moving late."
    ],
    "safety": "Walk-through pace at first.",
    "progressions": ["Add cuts.", "Live drive after five passes."],
    "regressions": ["Two passers only.", "Freeze after every pass."],
    "variations": ["Point while sliding.", "Call 'one pass away' or 'two passes away'."],
    "successCriteria": ["Both pistols pointed correctly at every freeze.", "Correct positions."],
    "gameApplication": "Seeing ball and player at once is the basis of help defense.",
    "repetitions": "3 rounds of 2 minutes",
