  "content": {
    "objective": "Get open on the wing against a denying defender using a well-timed V-cut or L-cut.",
    "setup": "Passer at the top; wing at the block; a defender denying.",
    "organization": "Four reps each side, then rotate.",
    "instructions": [
      "V-cut: walk the defender toward the block, plant the outside foot and push out to the wing.",
      "L-cut: walk up the lane line to the elbow, then step out sharply to the wing.",
      "Show a target hand away from the defender.",
      "Catch with both feet and face the basket (triple threat).",
      "Defender denies at walking pace, then live."
    ],
    "coachingPoints": [
      "Slow in, fast out.",
      "Plant on the outside foot.",
      "Target hand away from the defender."
    ],
    "commonMistakes": [
      "Rounding the cut.",
      "Catching too far out.",
      "No target hand."
    ],
    "safety": "Screens are set stationary and legal; defenders are allowed to see the screen in walk-throughs before live play.",
    "progressions": [
      "Defender plays full denial.",
      "Backdoor if overplayed."
    ],
    "regressions": [
      "No defender.",
      "Cones mark the turning points."
    ],
