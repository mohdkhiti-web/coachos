  "content": {
    "objective": "Read the defenders' positioning after a ball screen to decide between a roll and a pop.",
    "setup": "A ball handler and screener run a side ball screen against two live defenders.",
    "organization": "",
    "instructions": [
      "The screener sets a solid ball screen for the ball handler.",
      "If the screener's defender hedges hard, the screener rolls hard to the rim.",
      "If the screener's defender stays attached, the screener pops to an open spot instead.",
      "The ball handler reads the same defenders to decide whether to attack or pass."
    ],
    "coachingPoints": [
      "Set the screen with a wide, stationary base.",
      "Read the help defender's body position, not just guess.",
      "Ball handler should attack downhill off a good screen, not drift sideways."
    ],
    "commonMistakes": [
      "Rolling and popping randomly instead of reading the defense.",
      "Ball handler going too wide around the screen and losing the advantage.",
      "Crowding a teammate's space instead of keeping good spacing."
    ],
    "safety": "Screens must be legal and stationary; defenders should not initiate extra contact.",
