  "content": {
    "objective": "Beat a denying defender with a V-cut or a back-door cut, and complete the entry pass from the top.",
    "setup": "Guard at the top with the ball; wing with a defender in denial.",
    "organization": "Rotate guard, wing, defender.",
    "instructions": [
      "The wing walks the defender toward the lane.",
      "V-cut: plant and sprint back out to the wing, showing the outside hand.",
      "If the defender overplays, plant and cut back door to the rim.",
      "The guard reads the cut and passes: chest pass to the V-cut, bounce pass to the back door.",
      "Play the possession out 1v1 if the entry is made on the wing."
    ],
    "coachingPoints": [
      "Change of speed: slow in, fast out.",
      "Show the hand away from the defender.",
      "Passer fakes high before a bounce pass back door."
    ],
    "commonMistakes": [
      "Cutting at one speed, so the defender stays attached.",
      "Passing to the hand next to the defender.",
      "Forcing the entry into a defender's hand."
    ],
    "safety": "Wing and defender may not push off; contact as in a game.",
    "progressions": ["Defend the guard too (2v2).", "Add a weak-side help defender."],
    "regressions": ["Defender gives a half-step cushion.", "V-cut only, no back door."],
    "variations": ["Entry from the sideline (inbound).", "Use a flare cut instead of a V-cut."],
    "successCriteria": [
      "Entry completed within five seconds on most reps.",
      "Correct pass type for the cut."
    ],
    "gameApplication": "Getting the ball to the wing is the first step of most half-court offenses; denial is how defenses take it away.",
