  "content": {
    "objective": "Stop smoothly off a live push and shoot with the same mechanics as a catch-and-shoot.",
    "setup": "Shooter starts at the three-point line with a ball, facing the basket.",
    "organization": "",
    "instructions": [
      "Push hard toward the basket for two or three strokes.",
      "Brake to a controlled stop without drifting forward.",
      "Rise into a balanced shot immediately off the stop.",
      "Collect the rebound and move to the next spot around the arc."
    ],
    "coachingPoints": [
      "Brake fully before releasing — a still-moving chair throws the shot off.",
      "Gather the ball before the chair even stops, not after.",
      "Keep the same release point used in catch-and-shoot work."
    ],
    "commonMistakes": [
      "Shooting while the chair is still drifting forward.",
      "Taking too many pushes and losing rhythm before shooting.",
      "Dropping the follow-through early instead of holding it."
    ],
    "safety": "Make sure the approach lane is clear before pushing at speed.",
