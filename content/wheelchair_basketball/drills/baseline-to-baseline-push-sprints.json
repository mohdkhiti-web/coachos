    "objective": "Build top-end push conditioning through repeated sprints to progressively farther lines and back.",
    "setup": "Players line up on the baseline with clear sprint lanes down the court.",
    "organization": "",
    "instructions": [
      "Push to the near free-throw line and back to the baseline.",
      "Push to half court and back to the baseline.",
      "Push to the far free-throw line and back to the baseline.",
      "Push the full length of the court and back to finish."
    ],
    "coachingPoints": [
      "Touch each line clearly, not just approximately.",
      "Push through the whole set rather than slowing in the middle.",
      "Use quick, controlled turns at each line rather than a lazy curve."
    ],
    "commonMistakes": [
      "Rounding the turn instead of touching the actual line.",
      "Pacing too conservatively on the shorter early sprints.",
      "Pacing too conservatively instead of working at real effort."
    ],
    "safety": "Make sure the full length of the court is clear and the floor is dry.",
