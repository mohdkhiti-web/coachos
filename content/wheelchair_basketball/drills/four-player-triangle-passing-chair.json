    "objective": "Move the ball quickly around the group with no dribble to rely on if a catch is awkward.",
    "setup": "Four players form a wide square roughly five metres apart, one ball to start.",
    "organization": "",
    "instructions": [
      "Pass the ball around the square in one direction with no dribbling.",
      "Catch and square the chair to the next receiver before passing.",
      "After one minute, reverse the direction of the passing.",
      "Add a defender in the middle for an advanced group once the pattern is smooth."
    ],
    "coachingPoints": [
      "Square the chair to the target before releasing every pass.",
      "Use a firm pass, not a soft one, to keep the pace moving.",
      "Reset position quickly after every catch."
    ],
    "commonMistakes": [
      "Letting the square shape drift out of its spacing over time.",
      "Passing before the chair is actually squared to the target.",
      "Passing from a standstill instead of stepping the chair into it."
    ],
    "safety": "Keep enough room so a second group's passes don't cross this one's space.",
