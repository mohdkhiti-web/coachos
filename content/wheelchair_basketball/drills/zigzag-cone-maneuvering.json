  "content": {
    "objective": "Change direction sharply at each cone while keeping the chair under full control.",
    "setup": "Five cones are set in a wide zig-zag down the length of the court.",
    "organization": "",
    "instructions": [
      "Push toward the first cone at a controlled pace.",
      "Turn sharply around it and push toward the next cone on the opposite side.",
      "Continue the full zig-zag pattern to the end.",
      "Push back to the start at an easy pace and repeat, building speed each round."
    ],
    "coachingPoints": [
      "Lean slightly into each turn for stability.",
      "Push harder with the outside hand through the turn to carry speed.",
      "Keep the eyes up and looking ahead, not down at the wheels."
    ],
    "commonMistakes": [
      "Slowing to a near-stop at every cone instead of carrying momentum.",
      "Clipping the cone instead of turning tightly around it.",
      "Letting the trunk do the work instead of the arms and shoulders."
    ],
    "safety": "Make sure the cone line is clear of other groups before starting.",
