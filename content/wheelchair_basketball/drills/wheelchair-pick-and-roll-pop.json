  "content": {
    "objective": "Read the help defender to decide between the screener popping for a shot and rolling to the rim.",
    "setup": "A ball handler and screener run a side ball screen against two live defenders.",
    "organization": "",
    "instructions": [
      "The screener sets a solid, stationary ball screen for the ball handler.",
      "If the screener's defender helps hard, the screener pops to an open spot for a shot.",
      "If the defender stays attached to the screener, the ball handler attacks downhill instead.",
      "The ball handler reads the same defenders to decide whether to shoot, pass, or attack."
    ],
    "coachingPoints": [
      "Set the screen with the chair fully stationary.",
      "Read the help defender's chair position, not just guess.",
      "Ball handler should attack downhill off a good screen, not drift sideways."
    ],
    "commonMistakes": [
      "Popping and rolling randomly instead of reading the defense.",
      "Ball handler going too wide around the screen and losing the advantage.",
      "Cutting without actually drawing any real defensive attention."
    ],
    "safety": "Screens must be legal and stationary; defenders should not initiate extra contact.",
