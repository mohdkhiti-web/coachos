  "content": {
    "objective": "Learn to play inside-out by requiring the ball to touch a player near the rim before shooting.",
    "setup": "Four offensive players face four defenders in a half-court game with a constraint rule in place.",
    "organization": "",
    "instructions": [
      "Play live 4v4 to a target score.",
      "Before any shot attempt, the ball must touch a player positioned near the block.",
      "If the rule is violated, the possession ends in a turnover regardless of the shot's result.",
      "Rotate teams after every five possessions."
    ],
    "coachingPoints": [
      "Look to touch the post early in the possession, not as an afterthought.",
      "The post player should look to score or kick back out quickly, not hold the ball.",
      "Keep good spacing so the post pass is actually available."
    ],
    "commonMistakes": [
      "Forcing a quick shot and forgetting the touch constraint entirely.",
      "The post player holding the ball too long once they receive it.",
      "Playing at a walk-through pace instead of real game speed."
    ],
    "safety": "Keep contact controlled; call fouls to maintain a fair pace.",
