  "content": {
    "objective": "Build the verbal habits that make team defense work — every action called out loud.",
    "setup": "Four offensive players pass around the perimeter against four live defenders in a shell shape.",
    "organization": "",
    "instructions": [
      "Every defender calls 'ball' when guarding the ball and 'help' or 'deny' otherwise.",
      "On a drive, the helping defender calls 'help left' or 'help right' loudly.",
      "On a closeout, the closing defender calls 'shot' or 'ball' as they arrive.",
      "A defense that stays silent for a possession restarts that possession."
    ],
    "coachingPoints": [
      "Communicate before moving, not after.",
      "Keep calls short and specific, not vague shouting.",
      "Make eye contact with teammates during rotations when possible."
    ],
    "commonMistakes": [
      "Rotating correctly but silently, which breaks down under real pressure.",
      "Calling out too late for the information to actually help anyone.",
      "Ball-watching instead of tracking both the ball and the assignment."
    ],
    "safety": "Keep ball movement controlled enough that communication, not chaos, is the focus.",
