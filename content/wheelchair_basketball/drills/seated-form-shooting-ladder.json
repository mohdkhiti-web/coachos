  "content": {
    "objective": "Build a clean, repeatable seated shot, only moving back once makes are consistent.",
    "setup": "Shooter starts directly under the basket with a ball.",
    "organization": "",
    "instructions": [
      "Make five shots in a row directly under the basket using correct seated form.",
      "Move to the block and repeat, then the elbow, then the free-throw line.",
      "Stay at a spot longer than planned if it isn't making five in a row within ten shots.",
      "Collect your own rebound each time to keep the pace quick."
    ],
    "coachingPoints": [
      "Drive the shot with the trunk and shoulders, not by rocking the chair.",
      "Keep the base stable through the chair's footprint on every release.",
      "Hold the follow-through after every shot."
    ],
    "commonMistakes": [
      "Rushing back to the free-throw line before form is solid closer in.",
      "Using the chair's momentum to generate power instead of the upper body.",
      "Rushing the release instead of trusting the mechanics."
    ],
    "safety": "Watch for other players' rebounds crossing the shooting lane.",
