    "objective": "Keep good floor balance while passing and cutting continuously with no defense yet.",
    "setup": "Five players space out around the perimeter, one ball to start.",
    "organization": "",
    "instructions": [
      "Pass the ball to any open teammate and cut toward the basket.",
      "A teammate not involved in the cut fills the vacated spot.",
      "Continue passing, cutting and filling continuously for two minutes.",
      "Add a coach calling 'reverse' to force the ball the opposite direction occasionally."
    ],
    "coachingPoints": [
      "Keep the five spots balanced at all times — never bunch two chairs together.",
      "Cut with purpose, not just to be moving.",
      "Fill spots promptly so spacing never collapses."
    ],
