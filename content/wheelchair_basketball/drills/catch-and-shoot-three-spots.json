    "objective": "Catch the ball already squared and release in one motion, with no wasted adjustment.",
    "setup": "A passer feeds the shooter in turn at the left wing, top of the key and right wing.",
    "organization": "",
    "instructions": [
      "Square the chair to the basket before the pass arrives.",
      "Catch with the hands already shaped for the shot.",
      "Release immediately, no extra dribble or adjustment.",
      "Make five at each spot before moving on, then switch roles with the passer."
    ],
    "coachingPoints": [
      "Square up before the catch, not after.",
      "Keep the same release point regardless of the spot.",
      "Catch and shoot in one continuous motion."
    ],
    "commonMistakes": [
      "Catching off-angle and needing to re-square before shooting.",
      "Rushing the release before the chair is actually set.",
      "Rocking the chair to generate power instead of using the trunk."
    ],
    "safety": "Keep the passer out of the shooter's direct line to the basket.",
