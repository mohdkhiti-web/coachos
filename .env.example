# CoachOS environment variables. Copy to .env.local (or run `npm run setup` for local dev).
# Only src/lib/env.ts reads these — it validates them at boot and fails fast if something is wrong.

# --- App ---------------------------------------------------------------------------------
# Public origin of the app (used for auth links, trusted origins, Server Action origin checks).
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---------------------------------------------------------------
# Runtime connection. MUST be the non-superuser, NOBYPASSRLS `coachos_app` role, otherwise
# row-level security is meaningless. Use the *pooled* endpoint on Neon.
DATABASE_URL=postgres://coachos_app:CHANGE_ME@127.0.0.1:54329/coachos
# Migrations only (owner role). Never given to the running app.
DATABASE_OWNER_URL=postgres://coachos_owner:CHANGE_ME@127.0.0.1:54329/coachos
# One-time role bootstrap on a hosted DB (see `npm run db:bootstrap`):
# DATABASE_ADMIN_URL=postgres://<privileged-user>:...@<host>/<db>
# COACHOS_OWNER_PASSWORD=...
# COACHOS_APP_PASSWORD=...
DB_POOL_MAX=10

# --- Auth --------------------------------------------------------------------------------
# >= 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Breached-password check (Have I Been Pwned, k-anonymity). Keep true outside tests.
AUTH_BREACH_CHECK=true
# Database-backed rate limiting of auth endpoints.
AUTH_RATE_LIMIT=true

# --- Email -------------------------------------------------------------------------------
# console (dev: prints links in the server terminal) | file (tests) | resend (production)
MAIL_TRANSPORT=console
MAIL_FROM="CoachOS <no-reply@your-verified-domain.com>"
RESEND_API_KEY=
# Production refuses non-resend mail unless this is set (only for local prod-build testing).
# ALLOW_DEV_MAIL=true

# --- Deployment --------------------------------------------------------------------------
# Required in every deployed environment with more than one instance:
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=   (openssl rand -base64 32)
# --- Share links --------------------------------------------------------------------------
# Session share links are signed with a key derived from this (default: BETTER_AUTH_SECRET). Changing it
# invalidates every link that was handed out.
# SHARE_SECRET=   (openssl rand -base64 32)

# --- PDF export ---------------------------------------------------------------------------
# A headless Chromium prints the app's own print route. It is found automatically (system Chrome / Edge /
# Chromium); name one explicitly if needed. Without a browser the Download PDF button is simply not offered
# (Print -> Save as PDF keeps working).
# PDF_BROWSER_PATH=
# PDF_EXPORT=true
# PDF_MAX_CONCURRENT=2
# PDF_TIMEOUT_MS=45000
# PDF_RATE_PER_MINUTE=12   (exports one person may start per minute)
LOG_LEVEL=info
